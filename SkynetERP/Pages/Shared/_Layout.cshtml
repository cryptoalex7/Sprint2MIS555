<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SkynetERP</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SkynetERP.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-modern mb-3">
            <div class="container-fluid px-4">
                <a class="navbar-brand modern-brand" asp-area="" asp-page="/Index">
                    <i class="fas fa-cube me-2"></i>SkynetERP
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 modern-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var userRole = User.FindFirst("Role")?.Value ?? User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
                            @if (userRole == "Admin")
                            {
                                <li class="nav-item">
                                    <a class="nav-link modern-nav-link" asp-area="" asp-page="/Dashboard">
                                        <i class="fas fa-tachometer-alt me-2"></i>Dashboard
                                    </a>
                                </li>
                            }
                            @if (userRole == "Admin" || userRole == "HR")
                            {
                                <li class="nav-item">
                                    <a class="nav-link modern-nav-link" asp-area="" asp-page="/HRM">
                                        <i class="fas fa-users me-2"></i>HRM
                                    </a>
                                </li>
                            }
                            @if (userRole == "Admin" || userRole == "Vendor")
                            {
                                <li class="nav-item">
                                    <a class="nav-link modern-nav-link" asp-area="" asp-page="/VendorManagement">
                                        <i class="fas fa-building me-2"></i>Vendor Management
                                    </a>
                                </li>
                            }
                            @if (userRole == "Admin" || userRole == "Accountant")
                            {
                                <li class="nav-item">
                                    <a class="nav-link modern-nav-link" asp-area="" asp-page="/FinancialManagement">
                                        <i class="fas fa-dollar-sign me-2"></i>Financial Management
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link modern-nav-link" asp-area="" asp-page="/Transactions">
                                        <i class="fas fa-exchange-alt me-2"></i>Transactions
                                    </a>
                                </li>
                            }
                            @if (userRole == "Admin" || userRole == "Customer")
                            {
                                <li class="nav-item">
                                    <a class="nav-link modern-nav-link" asp-area="" asp-page="/CRM">
                                        <i class="fas fa-handshake me-2"></i>CRM
                                    </a>
                                </li>
                            }
                            @if (userRole == "Admin" || userRole == "InventoryManager")
                            {
                                <li class="nav-item">
                                    <a class="nav-link modern-nav-link" asp-area="" asp-page="/Inventory">
                                        <i class="fas fa-boxes me-2"></i>Inventory
                                    </a>
                                </li>
                            }
                        }
                        <li class="nav-item">
                            <a class="nav-link modern-nav-link" asp-area="" asp-page="/Privacy">
                                <i class="fas fa-shield-alt me-2"></i>Privacy
                            </a>
                        </li>
                    </ul>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="navbar-nav">
                            <div class="nav-item dropdown">
                                <a class="nav-link modern-user-dropdown dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-user-circle me-2"></i>@User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end modern-dropdown">
                                    <li><a class="dropdown-item modern-dropdown-item" href="/Logout"><i class="fas fa-sign-out-alt me-2"></i>Logout</a></li>
                                </ul>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid px-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container-fluid px-4">
            &copy; 2025 - SkynetERP - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

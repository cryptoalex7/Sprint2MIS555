                    <h5>Total Open Balance</h5>
                    <p class="display-5 @(Model.OpenBalances >= 0 ? "text-success" : "text-danger")">$@Model.OpenBalances.ToString("N2")</p>
                </div>
            </div>
        </div>
    </div>
    
</div>


@page
@model SkynetERP.Pages.FinancialManagementModel
@{
    ViewData["Title"] = "Financial Management";
}

@Html.AntiForgeryToken()

<div class="hrm-page">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-4 fw-bold text-primary mb-0">Financial Management</h1>
            <p class="text-muted">Manage your financial data, transactions, and accounts</p>
        </div>
    </div>

    <!-- Overview Cards -->
    <div class="row mb-5">
        <div class="col-12">
            <h2 class="h4 fw-bold mb-3 text-dark">Overview</h2>
            <div class="row g-3">
                <!-- Accounts Card -->
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="card shadow-sm border-0 overview-card clickable-card" data-section="accounts">
                        <div class="card-body p-3">
                            <h6 class="card-title fw-bold mb-2">Accounts</h6>
                            <div class="display-5 fw-bold text-primary mb-1">@Model.ActiveAccountCount</div>
                            <small class="text-muted">Active: @Model.ActiveAccountCount</small>
                        </div>
                    </div>
                </div>
                
                <!-- Partners Card -->
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="card shadow-sm border-0 overview-card clickable-card" data-section="partners">
                        <div class="card-body p-3">
                            <h6 class="card-title fw-bold mb-2">Partners</h6>
                            <div class="display-5 fw-bold text-primary mb-1">@(Model.CustomerCount + Model.VendorCount + Model.BothCount)</div>
                            <small class="text-muted">Cust: @Model.CustomerCount • Vend: @Model.VendorCount • Both: @Model.BothCount</small>
                        </div>
                    </div>
                </div>
                
                <!-- Invoices Card -->
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="card shadow-sm border-0 overview-card clickable-card" data-section="invoices">
                        <div class="card-body p-3">
                            <h6 class="card-title fw-bold mb-2">Invoices</h6>
                            <div class="display-5 fw-bold text-primary mb-1">@Model.Invoices.Count</div>
                            <small class="text-muted">AR: $@Model.TotalAR.ToString("N2") • AP: $@Model.TotalAP.ToString("N2")</small>
                        </div>
                    </div>
                </div>
                
                <!-- Open Balances Card -->
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="card shadow-sm border-0 overview-card clickable-card" data-section="open-balances">
                        <div class="card-body p-3">
                            <h6 class="card-title fw-bold mb-2">Open Balances</h6>
                            <div class="display-5 fw-bold @(Model.OpenBalances >= 0 ? "text-success" : "text-danger") mb-1">$@Model.OpenBalances.ToString("N2")</div>
                            <small class="text-muted">Open AP: $@Model.TotalAP.ToString("N2")</small>
                        </div>
                    </div>
                </div>
                
                <!-- Payments Card -->
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="card shadow-sm border-0 overview-card clickable-card" data-section="payments">
                        <div class="card-body p-3">
                            <h6 class="card-title fw-bold mb-2">Payments</h6>
                            <div class="display-5 fw-bold text-primary mb-1">@Model.Payments.Count</div>
                            <small class="text-muted">In: $@Model.TotalInflow.ToString("N2") • Out: $@Model.TotalOutflow.ToString("N2")</small>
                        </div>
                    </div>
                </div>
                
                <!-- Journal Card -->
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="card shadow-sm border-0 overview-card clickable-card" data-section="journal">
                        <div class="card-body p-3">
                            <h6 class="card-title fw-bold mb-2">Journal</h6>
                            <div class="display-5 fw-bold text-primary mb-1">@Model.JournalEntryCount</div>
                            <small class="text-muted">Lines: @Model.JournalLineCount</small>
                        </div>
                    </div>
                </div>
                
                <!-- Tax Rates Card -->
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="card shadow-sm border-0 overview-card clickable-card" data-section="tax-rates">
                        <div class="card-body p-3">
                            <h6 class="card-title fw-bold mb-2">Tax Rates</h6>
                            <div class="display-5 fw-bold text-primary mb-1">@Model.TaxRateCount</div>
                            <small class="text-muted">Configured</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Toolbar -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <form method="get" class="row g-3">
                        <div class="col-md-3">
                            <label for="partnerTypeFilter" class="form-label fw-semibold">Filter Partners</label>
                            <select class="form-select" id="partnerTypeFilter" name="PartnerTypeFilter" onchange="this.form.submit()">
                                <option value="">All Partners</option>
                                <option value="Customer" selected="@(Model.PartnerTypeFilter == "Customer")">Customers</option>
                                <option value="Vendor" selected="@(Model.PartnerTypeFilter == "Vendor")">Vendors</option>
                                <option value="Both" selected="@(Model.PartnerTypeFilter == "Both")">Both</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="invoiceTypeFilter" class="form-label fw-semibold">Filter Invoices</label>
                            <select class="form-select" id="invoiceTypeFilter" name="InvoiceTypeFilter" onchange="this.form.submit()">
                                <option value="">All Invoices</option>
                                <option value="AR" selected="@(Model.InvoiceTypeFilter == "AR")">Accounts Receivable</option>
                                <option value="AP" selected="@(Model.InvoiceTypeFilter == "AP")">Accounts Payable</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="paymentTypeFilter" class="form-label fw-semibold">Filter Payments</label>
                            <select class="form-select" id="paymentTypeFilter" name="PaymentTypeFilter" onchange="this.form.submit()">
                                <option value="">All Payments</option>
                                <option value="Inflow" selected="@(Model.PaymentTypeFilter == "Inflow")">Inflow</option>
                                <option value="Outflow" selected="@(Model.PaymentTypeFilter == "Outflow")">Outflow</option>
                            </select>
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <a href="/FinancialManagement" class="btn btn-outline-secondary w-100">
                                <i class="fas fa-times me-1"></i>Clear Filters
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast Container -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1055;">
        <div id="successToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="true" data-bs-delay="5000">
            <div class="toast-header bg-success text-white d-flex align-items-center">
                <i class="fas fa-check-circle me-2"></i>
                <strong class="me-auto">Success</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body bg-white" id="successToastBody"></div>
        </div>
        <div id="errorToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="true" data-bs-delay="5000">
            <div class="toast-header bg-danger text-white d-flex align-items-center">
                <i class="fas fa-exclamation-circle me-2"></i>
                <strong class="me-auto">Error</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body bg-white" id="errorToastBody"></div>
        </div>
    </div>

    <!-- Accounts Section -->
    <div class="row mb-4 section-content" id="accounts-section" style="display: none;">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <h2 class="h4 mb-0 fw-bold">Accounts</h2>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <button class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#addAccountModal">
                                <i class="fas fa-plus me-1"></i>Add Account
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-hrm mb-0">
                            <thead class="table-primary">
                                <tr>
                                    <th>Account Name</th>
                                    <th>Type</th>
                                    <th>Bank</th>
                                    <th>Account Number</th>
                                    <th>Balance</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var account in Model.Accounts)
                                {
                                    <tr>
                                        <td class="fw-semibold">@account.AccountName</td>
                                        <td>@account.AccountType</td>
                                        <td>@account.BankName</td>
                                        <td>@account.AccountNumber</td>
                                        <td class="@(account.Balance >= 0 ? "text-success" : "text-danger") fw-bold">$@account.Balance.ToString("N2")</td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-warning edit-account-btn" data-account-id="@account.Id" data-account-name="@account.AccountName" data-account-type="@account.AccountType" data-account-bank="@account.BankName" data-account-number="@account.AccountNumber" data-account-balance="@account.Balance" data-account-description="@account.Description">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger delete-account-btn" data-account-id="@account.Id" data-account-name="@account.AccountName">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Partners Section -->
    <div class="row mb-4 section-content" id="partners-section" style="display: none;">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <h2 class="h4 mb-0 fw-bold">Partners</h2>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <button class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#addPartnerModal">
                                <i class="fas fa-plus me-1"></i>Add Partner
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-hrm mb-0">
                            <thead class="table-primary">
                                <tr>
                                    <th>Name</th>
                                    <th>Type</th>
                                    <th>Email</th>
                                    <th>Phone</th>
                                    <th>City</th>
                                    <th>State</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var partner in Model.Partners)
                                {
                                    <tr>
                                        <td class="fw-semibold">@partner.Name</td>
                                        <td><span class="badge @(partner.Type == "Customer" ? "bg-success" : partner.Type == "Vendor" ? "bg-info" : "bg-warning")">@partner.Type</span></td>
                                        <td>@partner.Email</td>
                                        <td>@partner.Phone</td>
                                        <td>@partner.City</td>
                                        <td>@partner.State</td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-warning edit-partner-btn" data-partner-id="@partner.Id" data-partner-name="@partner.Name" data-partner-type="@partner.Type" data-partner-email="@partner.Email" data-partner-phone="@partner.Phone" data-partner-address="@partner.Address" data-partner-city="@partner.City" data-partner-state="@partner.State" data-partner-zip="@partner.ZipCode" data-partner-contact="@partner.ContactPerson" data-partner-notes="@partner.Notes">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger delete-partner-btn" data-partner-id="@partner.Id" data-partner-name="@partner.Name">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tax Rates Section -->
    <div class="row mb-4 section-content" id="tax-rates-section" style="display: none;">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <h2 class="h4 mb-0 fw-bold">Tax Rates</h2>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <button class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#addTaxRateModal">
                                <i class="fas fa-plus me-1"></i>Add Tax Rate
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-hrm mb-0">
                            <thead class="table-primary">
                                <tr>
                                    <th>Name</th>
                                    <th>Rate</th>
                                    <th>Type</th>
                                    <th>Jurisdiction</th>
                                    <th>Effective Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var taxRate in Model.TaxRates)
                                {
                                    <tr>
                                        <td class="fw-semibold">@taxRate.Name</td>
                                        <td>@taxRate.Rate.ToString("N2")%</td>
                                        <td>@taxRate.TaxType</td>
                                        <td>@taxRate.Jurisdiction</td>
                                        <td>@taxRate.EffectiveDate.ToString("MM/dd/yyyy")</td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-warning edit-taxrate-btn" data-taxrate-id="@taxRate.Id" data-taxrate-name="@taxRate.Name" data-taxrate-rate="@taxRate.Rate" data-taxrate-type="@taxRate.TaxType" data-taxrate-jurisdiction="@taxRate.Jurisdiction" data-taxrate-description="@taxRate.Description" data-taxrate-effectivedate="@taxRate.EffectiveDate.ToString("yyyy-MM-dd")">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger delete-taxrate-btn" data-taxrate-id="@taxRate.Id" data-taxrate-name="@taxRate.Name">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Invoices Section -->
    <div class="row mb-4 section-content" id="invoices-section" style="display: none;">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <h2 class="h4 mb-0 fw-bold">Invoices</h2>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <button class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#addInvoiceModal">
                                <i class="fas fa-plus me-1"></i>Add Invoice
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-hrm mb-0">
                            <thead class="table-primary">
                                <tr>
                                    <th>Invoice #</th>
                                    <th>Customer</th>
                                    <th>Type</th>
                                    <th>Amount</th>
                                    <th>Paid</th>
                                    <th>Balance</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var invoice in Model.Invoices)
                                {
                                    <tr>
                                        <td class="fw-semibold">@invoice.InvoiceNumber</td>
                                        <td>@invoice.CustomerName</td>
                                        <td><span class="badge @(invoice.InvoiceType == "AR" ? "bg-success" : "bg-danger")">@invoice.InvoiceType</span></td>
                                        <td class="fw-bold">$@invoice.Amount.ToString("N2")</td>
                                        <td>$@invoice.PaidAmount.ToString("N2")</td>
                                        <td class="@(invoice.Balance >= 0 ? "text-success" : "text-danger") fw-bold">$@invoice.Balance.ToString("N2")</td>
                                        <td><span class="badge @(invoice.Status == "Paid" ? "bg-success" : invoice.Status == "Overdue" ? "bg-danger" : "bg-warning")">@invoice.Status</span></td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-warning edit-invoice-btn" data-invoice-id="@invoice.Id" data-invoice-number="@invoice.InvoiceNumber" data-invoice-customer="@invoice.CustomerName" data-invoice-partnerid="@invoice.PartnerId" data-invoice-type="@invoice.InvoiceType" data-invoice-amount="@invoice.Amount" data-invoice-paid="@invoice.PaidAmount" data-invoice-date="@invoice.InvoiceDate.ToString("yyyy-MM-dd")" data-invoice-duedate="@invoice.DueDate.ToString("yyyy-MM-dd")" data-invoice-status="@invoice.Status" data-invoice-description="@invoice.Description" data-invoice-email="@invoice.CustomerEmail" data-invoice-phone="@invoice.CustomerPhone" data-invoice-notes="@invoice.Notes">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger delete-invoice-btn" data-invoice-id="@invoice.Id" data-invoice-number="@invoice.InvoiceNumber">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Invoice Lines Section -->
    <div class="row mb-4 section-content" id="invoice-lines-section" style="display: none;">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <h2 class="h4 mb-0 fw-bold">Invoice Lines</h2>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <button class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#addInvoiceLineModal">
                                <i class="fas fa-plus me-1"></i>Add Invoice Line
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-hrm mb-0">
                            <thead class="table-primary">
                                <tr>
                                    <th>Invoice #</th>
                                    <th>Description</th>
                                    <th>Quantity</th>
                                    <th>Unit Price</th>
                                    <th>Tax Rate</th>
                                    <th>Line Total</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in Model.InvoiceLines)
                                {
                                    <tr>
                                        <td>@(line.Invoice?.InvoiceNumber ?? "N/A")</td>
                                        <td class="fw-semibold">@line.Description</td>
                                        <td>@line.Quantity.ToString("N2")</td>
                                        <td>$@line.UnitPrice.ToString("N2")</td>
                                        <td>@line.TaxRate.ToString("N2")%</td>
                                        <td class="fw-bold">$@line.LineTotal.ToString("N2")</td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-warning edit-invoiceline-btn" data-line-id="@line.Id" data-line-invoiceid="@line.InvoiceId" data-line-description="@line.Description" data-line-quantity="@line.Quantity" data-line-unitprice="@line.UnitPrice" data-line-taxrate="@line.TaxRate" data-line-notes="@line.Notes">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger delete-invoiceline-btn" data-line-id="@line.Id" data-line-description="@line.Description">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Payments Section -->
    <div class="row mb-4 section-content" id="payments-section" style="display: none;">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <h2 class="h4 mb-0 fw-bold">Payments</h2>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <button class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#addPaymentModal">
                                <i class="fas fa-plus me-1"></i>Add Payment
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-hrm mb-0">
                            <thead class="table-primary">
                                <tr>
                                    <th>Payment #</th>
                                    <th>Payee</th>
                                    <th>Type</th>
                                    <th>Amount</th>
                                    <th>Date</th>
                                    <th>Method</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var payment in Model.Payments)
                                {
                                    <tr>
                                        <td class="fw-semibold">@payment.PaymentNumber</td>
                                        <td>@payment.PayeeName</td>
                                        <td><span class="badge @(payment.PaymentType == "Inflow" ? "bg-success" : "bg-danger")">@payment.PaymentType</span></td>
                                        <td class="fw-bold">$@payment.Amount.ToString("N2")</td>
                                        <td>@payment.PaymentDate.ToString("MM/dd/yyyy")</td>
                                        <td>@payment.PaymentMethod</td>
                                        <td><span class="badge @(payment.Status == "Completed" ? "bg-success" : payment.Status == "Pending" ? "bg-warning" : "bg-danger")">@payment.Status</span></td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-warning edit-payment-btn" data-payment-id="@payment.Id" data-payment-number="@payment.PaymentNumber" data-payment-payee="@payment.PayeeName" data-payment-partnerid="@payment.PartnerId" data-payment-type="@payment.PaymentType" data-payment-amount="@payment.Amount" data-payment-date="@payment.PaymentDate.ToString("yyyy-MM-dd")" data-payment-accountid="@payment.AccountId" data-payment-invoiceid="@payment.InvoiceId" data-payment-method="@payment.PaymentMethod" data-payment-status="@payment.Status" data-payment-description="@payment.Description" data-payment-ref="@payment.ReferenceNumber" data-payment-notes="@payment.Notes">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger delete-payment-btn" data-payment-id="@payment.Id" data-payment-number="@payment.PaymentNumber">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Journal Entries Section -->
    <div class="row mb-4 section-content" id="journal-section" style="display: none;">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <h2 class="h4 mb-0 fw-bold">Journal Entries</h2>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <button class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#addJournalEntryModal">
                                <i class="fas fa-plus me-1"></i>Add Journal Entry
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-hrm mb-0">
                            <thead class="table-primary">
                                <tr>
                                    <th>Entry #</th>
                                    <th>Date</th>
                                    <th>Description</th>
                                    <th>Reference</th>
                                    <th>Status</th>
                                    <th>Lines</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in Model.JournalEntries)
                                {
                                    <tr>
                                        <td class="fw-semibold">@entry.EntryNumber</td>
                                        <td>@entry.EntryDate.ToString("MM/dd/yyyy")</td>
                                        <td>@entry.Description</td>
                                        <td>@entry.Reference</td>
                                        <td><span class="badge @(entry.Status == "Posted" ? "bg-success" : "bg-warning")">@entry.Status</span></td>
                                        <td>@entry.JournalLines.Count</td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-warning edit-journalentry-btn" data-entry-id="@entry.Id" data-entry-number="@entry.EntryNumber" data-entry-date="@entry.EntryDate.ToString("yyyy-MM-dd")" data-entry-description="@entry.Description" data-entry-reference="@entry.Reference" data-entry-status="@entry.Status" data-entry-notes="@entry.Notes">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger delete-journalentry-btn" data-entry-id="@entry.Id" data-entry-number="@entry.EntryNumber">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Journal Lines Section -->
    <div class="row mb-4 section-content" id="journal-lines-section" style="display: none;">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <h2 class="h4 mb-0 fw-bold">Journal Lines</h2>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <button class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#addJournalLineModal">
                                <i class="fas fa-plus me-1"></i>Add Journal Line
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-hrm mb-0">
                            <thead class="table-primary">
                                <tr>
                                    <th>Entry #</th>
                                    <th>Account Code</th>
                                    <th>Account Name</th>
                                    <th>Description</th>
                                    <th>Debit</th>
                                    <th>Credit</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in Model.JournalLines)
                                {
                                    <tr>
                                        <td>@(line.JournalEntry?.EntryNumber ?? "N/A")</td>
                                        <td class="fw-semibold">@line.AccountCode</td>
                                        <td>@line.AccountName</td>
                                        <td>@line.Description</td>
                                        <td class="text-success fw-bold">$@line.DebitAmount.ToString("N2")</td>
                                        <td class="text-danger fw-bold">$@line.CreditAmount.ToString("N2")</td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-warning edit-journalline-btn" data-line-id="@line.Id" data-line-entryid="@line.JournalEntryId" data-line-accountcode="@line.AccountCode" data-line-accountname="@line.AccountName" data-line-description="@line.Description" data-line-debit="@line.DebitAmount" data-line-credit="@line.CreditAmount" data-line-notes="@line.Notes">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger delete-journalline-btn" data-line-id="@line.Id" data-line-description="@line.Description">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Open Balances Section (shows invoice balances summary) -->
    <div class="row mb-4 section-content" id="open-balances-section" style="display: none;">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h2 class="h4 mb-0 fw-bold">Open Balances Summary</h2>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h5>Accounts Receivable (AR)</h5>
                            <p class="display-6 text-success">$@Model.TotalAR.ToString("N2")</p>
                        </div>
                        <div class="col-md-6">
                            <h5>Accounts Payable (AP)</h5>
                            <p class="display-6 text-danger">$@Model.TotalAP.ToString("N2")</p>
                        </div>
                    </div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Show toast notifications from TempData
    @if (TempData["Success"] != null)
    {
        <text>
        const successToastEl = document.getElementById('successToast');
        const successToast = new bootstrap.Toast(successToastEl, { autohide: true, delay: 5000 });
        document.getElementById('successToastBody').textContent = '@Html.Raw(TempData["Success"])';
        successToast.show();
        </text>
    }
    @if (TempData["Error"] != null)
    {
        <text>
        const errorToastEl = document.getElementById('errorToast');
        const errorToast = new bootstrap.Toast(errorToastEl, { autohide: true, delay: 5000 });
        document.getElementById('errorToastBody').textContent = '@Html.Raw(TempData["Error"])';
        errorToast.show();
        </text>
    }

    // Restore open section from URL parameter
    const urlParams = new URLSearchParams(window.location.search);
    const openSection = urlParams.get('section');
    if (openSection) {
        const sectionElement = document.getElementById(openSection + '-section');
        const card = document.querySelector(`[data-section="${openSection}"]`);
        if (sectionElement && card) {
            document.querySelectorAll('.section-content').forEach(sec => {
                sec.style.display = 'none';
            });
            document.querySelectorAll('.clickable-card').forEach(c => {
                c.classList.remove('border-primary', 'border-2');
            });
            sectionElement.style.display = 'block';
            card.classList.add('border-primary', 'border-2');
            setTimeout(() => {
                sectionElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 100);
        }
    }

    // Clickable card functionality
    document.querySelectorAll('.clickable-card').forEach(card => {
        card.style.cursor = 'pointer';
        card.addEventListener('click', function() {
            const section = this.getAttribute('data-section');
            const sectionElement = document.getElementById(section + '-section');
            
            if (sectionElement) {
                const isVisible = sectionElement.style.display !== 'none';
                
                document.querySelectorAll('.section-content').forEach(sec => {
                    sec.style.display = 'none';
                });
                
                document.querySelectorAll('.clickable-card').forEach(c => {
                    c.classList.remove('border-primary', 'border-2');
                });
                
                // Show selected section if it was hidden
                if (!isVisible) {
                    sectionElement.style.display = 'block';
                    this.classList.add('border-primary', 'border-2');
                    sectionElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            }
        });
        
        card.addEventListener('mouseenter', function() {
            if (!this.classList.contains('border-primary')) {
                this.style.transform = 'translateY(-2px)';
                this.style.transition = 'transform 0.2s';
            }
        });
        

    // Generic delete handler function
    function setupDeleteHandler(selector, handlerName, idAttr, nameAttr) {
        document.querySelectorAll(selector).forEach(btn => {
            btn.addEventListener('click', function() {
                const id = this.getAttribute(idAttr);
                const name = this.getAttribute(nameAttr);
                
                if (confirm(`Are you sure you want to delete ${name}?`)) {
                    const formData = new FormData();
                    formData.append('id', id);
                    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                    formData.append('__RequestVerificationToken', token);
                    
                    fetch(`?handler=${handlerName}`, {
                        method: 'POST',
                        body: formData
                    })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            location.reload();
                        } else {
                            alert(data.message || 'Error deleting record');
                        }
                    });
                }
            });
        });
    }
    

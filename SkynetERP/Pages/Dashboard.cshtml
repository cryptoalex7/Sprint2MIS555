@page
@model SkynetERP.Pages.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}

@Html.AntiForgeryToken()

<div class="hrm-page">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-4 fw-bold text-primary mb-0">Dashboard</h1>
            <p class="text-muted">Welcome back, @Model.Username! Manage your ERP modules from here.</p>
        </div>
    </div>

    <!-- Module Cards -->
    <div class="row g-4">
        <!-- HRM Module Card -->
        @if (Model.CanAccessHRM)
        {
            <div class="col-lg-6 col-md-12">
                <div class="card h-100 shadow-sm border-0 hrm-card dashboard-module-card" onclick="window.location.href='/HRM'" style="cursor: pointer;">
                    <div class="card-body p-5">
                        <div class="row align-items-center">
                            <div class="col-md-4 text-center mb-3 mb-md-0">
                                <div class="dashboard-icon mb-3">
                                    <i class="fas fa-users fa-5x text-primary"></i>
                                </div>
                            </div>
                            <div class="col-md-8">
                                <h2 class="h3 fw-bold text-primary mb-3">Human Resource Management</h2>
                                <p class="text-muted mb-4">Manage employees, track performance, and handle HR operations efficiently.</p>
                                <div class="d-flex flex-wrap gap-2 mb-3">
                                    <span class="badge badge-hrm bg-primary">Employee Management</span>
                                    <span class="badge badge-hrm bg-primary">Performance Tracking</span>
                                    <span class="badge badge-hrm bg-primary">Payroll</span>
                                </div>
                                <button class="btn btn-primary btn-lg w-100">
                                    <i class="fas fa-arrow-right me-2"></i>Access HRM Module
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Vendor Management Module Card -->
        @if (Model.CanAccessVendor)
        {
            <div class="col-lg-6 col-md-12">
                <div class="card h-100 shadow-sm border-0 hrm-card dashboard-module-card" onclick="window.location.href='/VendorManagement'" style="cursor: pointer;">
                    <div class="card-body p-5">
                        <div class="row align-items-center">
                            <div class="col-md-4 text-center mb-3 mb-md-0">
                                <div class="dashboard-icon mb-3">
                                    <i class="fas fa-building fa-5x text-success"></i>
                                </div>
                            </div>
                            <div class="col-md-8">
                                <h2 class="h3 fw-bold text-success mb-3">Vendor Management</h2>
                                <p class="text-muted mb-4">Manage vendor relationships, track deliveries, and monitor vendor performance.</p>
                                <div class="d-flex flex-wrap gap-2 mb-3">
                                    <span class="badge badge-hrm bg-success">Vendor Directory</span>
                                    <span class="badge badge-hrm bg-success">Delivery Tracking</span>
                                    <span class="badge badge-hrm bg-success">Contracts</span>
                                </div>
                                <button class="btn btn-success btn-lg w-100">
                                    <i class="fas fa-arrow-right me-2"></i>Access Vendor Module
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Quick Stats Section (if Admin) -->
    @if (Model.UserRole == "Admin")
    {
        <div class="row mt-5">
            <div class="col-12">
                <h2 class="h4 fw-bold mb-4 text-dark">Quick Overview</h2>
                <div class="row g-4">
                    <div class="col-md-3">
                        <div class="card shadow-sm border-0 hrm-card text-center">
                            <div class="card-body p-4">
                                <div class="hrm-icon mb-3">
                                    <i class="fas fa-users fa-3x text-primary"></i>
                                </div>
                                <h5 class="card-title fw-bold">Total Employees</h5>
                                <p class="card-text">
                                    <span class="display-6 fw-bold text-primary">@Model.TotalEmployees</span>
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card shadow-sm border-0 hrm-card text-center">
                            <div class="card-body p-4">
                                <div class="hrm-icon mb-3">
                                    <i class="fas fa-building fa-3x text-success"></i>
                                </div>
                                <h5 class="card-title fw-bold">Total Vendors</h5>
                                <p class="card-text">
                                    <span class="display-6 fw-bold text-success">@Model.TotalVendors</span>
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card shadow-sm border-0 hrm-card text-center">
                            <div class="card-body p-4">
                                <div class="hrm-icon mb-3">
                                    <i class="fas fa-truck fa-3x text-warning"></i>
                                </div>
                                <h5 class="card-title fw-bold">Deliveries</h5>
                                <p class="card-text">
                                    <span class="display-6 fw-bold text-warning">@Model.TotalDeliveries</span>
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card shadow-sm border-0 hrm-card text-center">
                            <div class="card-body p-4">
                                <div class="hrm-icon mb-3">
                                    <i class="fas fa-user-check fa-3x text-info"></i>
                                </div>
                                <h5 class="card-title fw-bold">Active Users</h5>
                                <p class="card-text">
                                    <span class="display-6 fw-bold text-info">@Model.TotalUsers</span>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
.dashboard-module-card {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border: 2px solid transparent;
}

.dashboard-module-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 50px rgba(0,0,0,0.15) !important;
    border-color: rgba(13, 110, 253, 0.3);
}

.dashboard-icon {
    transition: all 0.4s ease;
}

.dashboard-module-card:hover .dashboard-icon {
    transform: scale(1.1) rotate(5deg);
}

.dashboard-module-card .btn {
    transition: all 0.3s ease;
}

.dashboard-module-card:hover .btn {
    transform: translateX(5px);
}
</style>


@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="hrm-page">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h1 class="h2 mb-0 fw-bold">@ViewData["Title"]</h1>
                </div>
                <div class="card-body p-4">
                    <div class="privacy-content">
                        <h3 class="h4 text-primary mb-3">Information We Collect</h3>
                        <p class="mb-4">SkynetERP collects and processes personal information necessary to provide our enterprise resource planning services. This includes employee data, business information, and usage analytics to improve our platform.</p>
                        
                        <h3 class="h4 text-primary mb-3">How We Use Your Information</h3>
                        <ul class="mb-4">
                            <li>To provide and maintain our ERP services</li>
                            <li>To process and manage employee data</li>
                            <li>To improve our platform functionality</li>
                            <li>To communicate with users about our services</li>
                            <li>To comply with legal and regulatory requirements</li>
                        </ul>
                        
                        <h3 class="h4 text-primary mb-3">Data Security</h3>
                        <p class="mb-4">We implement industry-standard security measures to protect your data, including encryption, secure servers, and regular security audits. Your information is stored securely and accessed only by authorized personnel.</p>
                        
                        <h3 class="h4 text-primary mb-3">Your Rights</h3>
                        <p class="mb-4">You have the right to access, update, or delete your personal information. You can also request data portability or object to certain processing activities. Contact our support team for assistance with these requests.</p>
                        
                        <h3 class="h4 text-primary mb-3">Contact Us</h3>
                        <p class="mb-0">If you have any questions about this Privacy Policy, please contact us at <a href="mailto:privacy@skyneterp.com" class="text-primary">privacy@skyneterp.com</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.privacy-content {
    line-height: 1.8;
    color: #495057;
}

.privacy-content h3 {
    border-bottom: 2px solid #e9ecef;
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
}

.privacy-content ul {
    padding-left: 1.5rem;
}

.privacy-content li {
    margin-bottom: 0.5rem;
}

.privacy-content a {
    font-weight: 600;
    text-decoration: none;
}

.privacy-content a:hover {
    text-decoration: underline;
}
</style>

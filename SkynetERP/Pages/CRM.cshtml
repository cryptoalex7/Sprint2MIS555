@page
@model SkynetERP.Pages.CRMModel
@{
    ViewData["Title"] = "Customer Relationship Management";
}

@Html.AntiForgeryToken()

<div class="hrm-page">
    <!-- Toast Container -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1055;">
        <div id="successToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="true" data-bs-delay="5000">
            <div class="toast-header bg-success text-white d-flex align-items-center">
                <i class="fas fa-check-circle me-2"></i>
                <strong class="me-auto">Success</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body bg-white" id="successToastBody"></div>
        </div>
        <div id="errorToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="true" data-bs-delay="5000">
            <div class="toast-header bg-danger text-white d-flex align-items-center">
                <i class="fas fa-exclamation-circle me-2"></i>
                <strong class="me-auto">Error</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body bg-white" id="errorToastBody"></div>
        </div>
    </div>

    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-4 fw-bold text-primary mb-0">Customer Relationship Management</h1>
            <p class="text-muted">Manage your customer relationships and track interactions</p>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-5">
        <div class="col-12">
            <h2 class="h4 fw-bold mb-4 text-dark">Customer Statistics</h2>
            <div class="row g-4">
                <div class="col-lg-3 col-md-6">
                    <div class="card h-100 shadow-sm border-0 hrm-card">
                        <div class="card-body text-center p-4">
                            <div class="hrm-icon mb-3">
                                <i class="fas fa-users fa-3x text-primary"></i>
                            </div>
                            <h5 class="card-title fw-bold">Total Customers</h5>
                            <p class="card-text">
                                <span class="display-6 fw-bold text-primary">@Model.TotalCustomers</span>
                                <br>
                                <small class="text-muted">All Customers</small>
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="card h-100 shadow-sm border-0 hrm-card">
                        <div class="card-body text-center p-4">
                            <div class="hrm-icon mb-3">
                                <i class="fas fa-check-circle fa-3x text-success"></i>
                            </div>
                            <h5 class="card-title fw-bold">Active Customers</h5>
                            <p class="card-text">
                                <span class="display-6 fw-bold text-success">@Model.ActiveCustomers</span>
                                <br>
                                <small class="text-muted">Currently Active</small>
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="card h-100 shadow-sm border-0 hrm-card">
                        <div class="card-body text-center p-4">
                            <div class="hrm-icon mb-3">
                                <i class="fas fa-star fa-3x text-warning"></i>
                            </div>
                            <h5 class="card-title fw-bold">Reviews</h5>
                            <p class="card-text">
                                <span class="display-6 fw-bold text-warning">@Model.Reviews.Count</span>
                                <br>
                                <small class="text-muted">Total Reviews</small>
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="card h-100 shadow-sm border-0 hrm-card">
                        <div class="card-body text-center p-4">
                            <div class="hrm-icon mb-3">
                                <i class="fas fa-chart-line fa-3x text-info"></i>
                            </div>
                            <h5 class="card-title fw-bold">Average Rating</h5>
                            <p class="card-text">
                                @if (Model.Reviews.Any())
                                {
                                    var avgRating = Model.Reviews.Average(r => r.Rating);
                                    <span class="display-6 fw-bold text-info">@avgRating.ToString("F1")</span>
                                    <br>
                                    <small class="text-muted">Out of 5.0</small>
                                }
                                else
                                {
                                    <span class="display-6 fw-bold text-muted">N/A</span>
                                    <br>
                                    <small class="text-muted">No reviews yet</small>
                                }
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Row -->
    <div class="row">
        <!-- Customer Table Column -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold">
                        <i class="fas fa-table me-2"></i>Customer Directory
                    </h5>
                    <button type="button" class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#addCustomerModal">
                        <i class="fas fa-plus me-1"></i>Add Customer
                    </button>
                </div>
                <div class="card-body">
                    <!-- Search and Filter -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <input type="text" class="form-control" id="searchInput" placeholder="Search customers...">
                        </div>
                        <div class="col-md-4">
                            <select class="form-select" id="statusFilter">
                                <option value="">All Statuses</option>
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                                <option value="Lead">Lead</option>
                                <option value="Prospect">Prospect</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button type="button" class="btn btn-outline-secondary w-100" id="clearFilters">
                                <i class="fas fa-times"></i> Clear
                            </button>
                        </div>
                    </div>

                    <!-- Customer Table -->
                    <div class="table-responsive">
                        <table class="table table-hover" id="customerTable">
                            <thead class="table-primary">
                                <tr>
                                    <th scope="col" class="fw-bold">Name</th>
                                    <th scope="col" class="fw-bold">Company</th>
                                    <th scope="col" class="fw-bold">Email</th>
                                    <th scope="col" class="fw-bold">Status</th>
                                    <th scope="col" class="fw-bold">Last Contact</th>
                                    <th scope="col" class="fw-bold text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Customers != null && Model.Customers.Any())
                                {
                                    @foreach (var customer in Model.Customers)
                                    {
                                        var statusBadgeClass = customer.Status switch
                                        {
                                            "Active" => "bg-success",
                                            "Inactive" => "bg-secondary",
                                            "Lead" => "bg-info",
                                            "Prospect" => "bg-warning",
                                            _ => "bg-dark"
                                        };
                                        <tr data-customer-id="@customer.Id">
                                            <td class="fw-semibold">@customer.Name</td>
                                            <td>@customer.Company</td>
                                            <td><a href="mailto:@customer.Email">@customer.Email</a></td>
                                            <td><span class="badge @statusBadgeClass">@customer.Status</span></td>
                                            <td>@(customer.LastContact?.ToString("MM/dd/yyyy") ?? "Never")</td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    <button class="btn btn-sm btn-outline-warning edit-customer-btn" 
                                                            data-customer-id="@customer.Id"
                                                            data-customer-name="@customer.Name"
                                                            data-customer-company="@customer.Company"
                                                            data-customer-email="@customer.Email"
                                                            data-customer-phone="@customer.Phone"
                                                            data-customer-status="@customer.Status"
                                                            data-customer-lastcontact="@(customer.LastContact?.ToString("yyyy-MM-dd") ?? "")"
                                                            data-customer-notes="@customer.Notes"
                                                            title="Edit Customer">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-danger delete-customer-btn" 
                                                            data-customer-id="@customer.Id" 
                                                            data-customer-name="@customer.Name"
                                                            title="Delete Customer">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-4">
                                            No customers found. Click "Add Customer" to get started.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Reviews Section Column -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold">
                        <i class="fas fa-star me-2"></i>Customer Reviews / Testimonials
                    </h5>
                    <button type="button" class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#addReviewModal">
                        <i class="fas fa-plus me-1"></i>Add Review
                    </button>
                </div>
                <div class="card-body">
                    @if (Model.Reviews != null && Model.Reviews.Any())
                    {
                        <div class="reviews-container" style="max-height: 600px; overflow-y: auto; padding-right: 10px;">
                            <div class="list-group">
                                @foreach (var review in Model.Reviews)
                                {
                                    <div class="list-group-item mb-2 border rounded">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <h6 class="mb-1 fw-bold">@review.Title</h6>
                                                <small class="text-muted">@(review.ReviewerName ?? "Anonymous") - @review.ReviewDate.ToString("MM/dd/yyyy")</small>
                                            </div>
                                            <div class="text-warning">
                                                @for (int i = 0; i < review.Rating; i++)
                                                {
                                                    <i class="fas fa-star"></i>
                                                }
                                            </div>
                                        </div>
                                        <p class="mb-2 small">@review.ReviewText</p>
                                        @if (review.Customer != null)
                                        {
                                            <small class="text-muted">
                                                <i class="fas fa-user me-1"></i>@review.Customer.Name (@review.Customer.Company)
                                            </small>
                                        }
                                        <div class="mt-2">
                                            <button class="btn btn-sm btn-outline-danger delete-review-btn" 
                                                    data-review-id="@review.Id"
                                                    title="Delete Review">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center py-4">
                            <i class="fas fa-star fa-2x mb-3 d-block"></i>
                            No reviews yet. Click "Add Review" to get started.
                        </p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Customer Modal -->
<div class="modal fade modal-hrm" id="addCustomerModal" tabindex="-1" aria-labelledby="addCustomerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="addCustomerModalLabel">Add New Customer</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="AddCustomer" id="addCustomerForm">
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="addName" class="form-label fw-semibold">Name *</label>
                            <input type="text" class="form-control form-control-hrm" id="addName" name="Name" required>
                            <div class="invalid-feedback">Please provide a valid name.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="addCompany" class="form-label fw-semibold">Company *</label>
                            <input type="text" class="form-control form-control-hrm" id="addCompany" name="Company" required>
                            <div class="invalid-feedback">Please provide a company name.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="addEmail" class="form-label fw-semibold">Email *</label>
                            <input type="email" class="form-control form-control-hrm" id="addEmail" name="Email" required>
                            <div class="invalid-feedback">Please provide a valid email address.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="addPhone" class="form-label fw-semibold">Phone</label>
                            <input type="tel" class="form-control form-control-hrm" id="addPhone" name="Phone" pattern="\(\d{3}\)-\d{3}-\d{4}" placeholder="(555)-123-4567" maxlength="14">
                            <div class="invalid-feedback">Please provide a valid 10-digit phone number (555)-123-4567.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="addStatus" class="form-label fw-semibold">Status *</label>
                            <select class="form-select form-control-hrm" id="addStatus" name="Status" required>
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                                <option value="Lead">Lead</option>
                                <option value="Prospect">Prospect</option>
                            </select>
                            <div class="invalid-feedback">Please select a status.</div>
                        </div>
                        <div class="col-12">
                            <label for="addNotes" class="form-label fw-semibold">Notes</label>
                            <textarea class="form-control form-control-hrm" id="addNotes" name="Notes" rows="3"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Customer</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Customer Modal -->
<div class="modal fade modal-hrm" id="editCustomerModal" tabindex="-1" aria-labelledby="editCustomerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="editCustomerModalLabel">Edit Customer</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="UpdateCustomer" id="editCustomerForm" novalidate>
                <input type="hidden" id="editCustomerId" name="id" />
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="editName" class="form-label fw-semibold">Name *</label>
                            <input type="text" class="form-control form-control-hrm" id="editName" name="CustomerForm.Name" required>
                            <div class="invalid-feedback">Please provide a valid name.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="editCompany" class="form-label fw-semibold">Company *</label>
                            <input type="text" class="form-control form-control-hrm" id="editCompany" name="CustomerForm.Company" required>
                            <div class="invalid-feedback">Please provide a company name.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="editEmail" class="form-label fw-semibold">Email *</label>
                            <input type="email" class="form-control form-control-hrm" id="editEmail" name="CustomerForm.Email" required>
                            <div class="invalid-feedback">Please provide a valid email address.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="editPhone" class="form-label fw-semibold">Phone</label>
                            <input type="tel" class="form-control form-control-hrm" id="editPhone" name="CustomerForm.Phone" pattern="\(\d{3}\)-\d{3}-\d{4}" placeholder="(555)-123-4567" maxlength="14">
                            <div class="invalid-feedback">Please provide a valid 10-digit phone number (555)-123-4567.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="editStatus" class="form-label fw-semibold">Status *</label>
                            <select class="form-select form-control-hrm" id="editStatus" name="CustomerForm.Status" required>
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                                <option value="Lead">Lead</option>
                                <option value="Prospect">Prospect</option>
                            </select>
                            <div class="invalid-feedback">Please select a status.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="editLastContact" class="form-label fw-semibold">Last Contact</label>
                            <input type="date" class="form-control form-control-hrm" id="editLastContact" name="CustomerForm.LastContact">
                        </div>
                        <div class="col-12">
                            <label for="editNotes" class="form-label fw-semibold">Notes</label>
                            <textarea class="form-control form-control-hrm" id="editNotes" name="CustomerForm.Notes" rows="3"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Update Customer</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Add Review Modal -->
<div class="modal fade modal-hrm" id="addReviewModal" tabindex="-1" aria-labelledby="addReviewModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="addReviewModalLabel">Add Customer Review</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="AddReview" id="addReviewForm">
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label for="reviewCustomerId" class="form-label fw-semibold">Customer *</label>
                            <select class="form-select form-control-hrm" id="reviewCustomerId" name="CustomerId" required>
                                <option value="">Select Customer</option>
                                @if (Model.Customers != null)
                                {
                                    @foreach (var customer in Model.Customers)
                                    {
                                        <option value="@customer.Id">@customer.Name - @customer.Company</option>
                                    }
                                }
                            </select>
                            <div class="invalid-feedback">Please select a customer.</div>
                        </div>
                        <div class="col-12">
                            <label for="reviewTitle" class="form-label fw-semibold">Title *</label>
                            <input type="text" class="form-control form-control-hrm" id="reviewTitle" name="Title" required>
                            <div class="invalid-feedback">Please provide a review title.</div>
                        </div>
                        <div class="col-12">
                            <label for="reviewText" class="form-label fw-semibold">Review Text *</label>
                            <textarea class="form-control form-control-hrm" id="reviewText" name="ReviewText" rows="4" required></textarea>
                            <div class="invalid-feedback">Please provide review text.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="reviewRating" class="form-label fw-semibold">Rating *</label>
                            <select class="form-select form-control-hrm" id="reviewRating" name="Rating" required>
                                <option value="5">5 Stars</option>
                                <option value="4">4 Stars</option>
                                <option value="3">3 Stars</option>
                                <option value="2">2 Stars</option>
                                <option value="1">1 Star</option>
                            </select>
                            <div class="invalid-feedback">Please select a rating.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="reviewReviewerName" class="form-label fw-semibold">Reviewer Name</label>
                            <input type="text" class="form-control form-control-hrm" id="reviewReviewerName" name="ReviewerName">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Review</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold" id="deleteConfirmModalLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>Confirm Deletion
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3">Are you sure you want to delete this customer?</p>
                <div class="alert alert-warning mb-0">
                    <strong id="customerNameToDelete"></strong>
                </div>
                <p class="text-muted mt-3 mb-0">
                    <small>This action cannot be undone. All customer information and associated reviews will be permanently deleted.</small>
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancel
                </button>
                <form method="post" asp-page-handler="DeleteCustomer" id="deleteCustomerForm" style="display: inline;">
                    <input type="hidden" id="deleteCustomerId" name="id" />
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash me-1"></i>Yes, Delete Customer
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Toast notification function
        function showNotification(message, type) {
            const toastId = type === 'success' ? 'successToast' : 'errorToast';
            const toastBodyId = type === 'success' ? 'successToastBody' : 'errorToastBody';
            const toastElement = document.getElementById(toastId);
            const toastBody = document.getElementById(toastBodyId);
            
            toastBody.textContent = message;
            const toast = new bootstrap.Toast(toastElement);
            toast.show();
        }

        // Show toasts from TempData
        @if (TempData["Success"] != null)
        {
            <text>
            showNotification('@TempData["Success"]', 'success');
            </text>
        }
        @if (TempData["Error"] != null)
        {
            <text>
            showNotification('@TempData["Error"]', 'error');
            </text>
        }

        // Search and filter functionality
        document.getElementById('searchInput')?.addEventListener('input', filterTable);
        document.getElementById('statusFilter')?.addEventListener('change', filterTable);
        document.getElementById('clearFilters')?.addEventListener('click', function() {
            document.getElementById('searchInput').value = '';
            document.getElementById('statusFilter').value = '';
            filterTable();
        });

        function filterTable() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            const statusFilter = document.getElementById('statusFilter').value;
            const table = document.getElementById('customerTable');
            const rows = table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');

            for (let i = 0; i < rows.length; i++) {
                const row = rows[i];
                const name = row.cells[0].textContent.toLowerCase();
                const company = row.cells[1].textContent.toLowerCase();
                const email = row.cells[2].textContent.toLowerCase();
                const status = row.cells[3].textContent;

                const matchesSearch = name.includes(searchTerm) || company.includes(searchTerm) || email.includes(searchTerm);
                const matchesStatus = !statusFilter || status.includes(statusFilter);

                if (matchesSearch && matchesStatus) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            }
        }

        // Edit customer button handlers
        document.querySelectorAll('.edit-customer-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const customerId = this.getAttribute('data-customer-id');
                document.getElementById('editCustomerId').value = customerId;
                document.getElementById('editName').value = this.getAttribute('data-customer-name');
                document.getElementById('editCompany').value = this.getAttribute('data-customer-company');
                document.getElementById('editEmail').value = this.getAttribute('data-customer-email');
                
                // Format phone number when populating edit form
                let phone = this.getAttribute('data-customer-phone') || '';
                if (phone) {
                    // Remove all non-digit characters
                    const digits = phone.replace(/\D/g, '');
                    if (digits.length === 10) {
                        // Format as (xxx)-xxx-xxxx
                        phone = `(${digits.substring(0, 3)})-${digits.substring(3, 6)}-${digits.substring(6)}`;
                    }
                }
                document.getElementById('editPhone').value = phone;
                
                document.getElementById('editStatus').value = this.getAttribute('data-customer-status');
                document.getElementById('editLastContact').value = this.getAttribute('data-customer-lastcontact') || '';
                document.getElementById('editNotes').value = this.getAttribute('data-customer-notes') || '';
                
                const modal = new bootstrap.Modal(document.getElementById('editCustomerModal'));
                modal.show();
            });
        });

        // Delete customer button handlers
        document.querySelectorAll('.delete-customer-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const customerId = this.getAttribute('data-customer-id');
                const customerName = this.getAttribute('data-customer-name');
                document.getElementById('deleteCustomerId').value = customerId;
                document.getElementById('customerNameToDelete').textContent = customerName;
                
                const modal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
                modal.show();
            });
        });

        // Delete review button handlers
        document.querySelectorAll('.delete-review-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                if (confirm('Are you sure you want to delete this review?')) {
                    const reviewId = this.getAttribute('data-review-id');
                    const form = document.createElement('form');
                    form.method = 'POST';
                    form.action = window.location.pathname + '?handler=DeleteReview';
                    
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'id';
                    input.value = reviewId;
                    form.appendChild(input);
                    
                    const token = document.querySelector('input[name="__RequestVerificationToken"]');
                    if (token) {
                        const tokenInput = document.createElement('input');
                        tokenInput.type = 'hidden';
                        tokenInput.name = '__RequestVerificationToken';
                        tokenInput.value = token.value;
                        form.appendChild(tokenInput);
                    }
                    
                    document.body.appendChild(form);
                    form.submit();
                }
            });
        });

        // Phone number formatting function
        function formatPhoneNumber(input) {
            // Remove all non-digit characters
            let value = input.value.replace(/\D/g, '');
            
            // Limit to 10 digits
            if (value.length > 10) {
                value = value.substring(0, 10);
            }
            
            // Format as (xxx)-xxx-xxxx
            if (value.length >= 6) {
                value = `(${value.substring(0, 3)})-${value.substring(3, 6)}-${value.substring(6)}`;
            } else if (value.length >= 3) {
                value = `(${value.substring(0, 3)})${value.substring(3)}`;
            } else if (value.length > 0) {
                value = `(${value}`;
            }
            
            input.value = value;
        }

        // Auto-format phone number on input
        const addPhoneInput = document.getElementById('addPhone');
        if (addPhoneInput) {
            addPhoneInput.addEventListener('input', function() {
                formatPhoneNumber(this);
            });
        }

        const editPhoneInput = document.getElementById('editPhone');
        if (editPhoneInput) {
            editPhoneInput.addEventListener('input', function() {
                formatPhoneNumber(this);
            });
        }

        // Form validation for forms with novalidate attribute
        const formsWithNovalidate = document.querySelectorAll('form[novalidate]');
        formsWithNovalidate.forEach(form => {
            form.addEventListener('submit', function(event) {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                form.classList.add('was-validated');
            });
        });
    </script>
}


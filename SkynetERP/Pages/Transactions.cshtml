@page
@model SkynetERP.Pages.TransactionsModel
@{
    ViewData["Title"] = "Transaction Management";
}

@Html.AntiForgeryToken()

<div class="transactions-page">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-4 fw-bold text-primary mb-0">Transaction Management</h1>
            <p class="text-muted">Record and manage your revenue and expense transactions</p>
        </div>
    </div>

    <!-- Financial Metrics Summary -->
    <div class="row mb-4 g-3">
        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm border-0 h-100" style="background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%);">
                <div class="card-body p-4">
                    <h6 class="card-title fw-bold text-dark mb-3">
                        <i class="fas fa-arrow-up text-success me-2"></i>Total Revenue
                    </h6>
                    <div class="display-6 fw-bold text-success mb-2">$@Model.TotalRevenue.ToString("N2")</div>
                    <small class="text-muted">From completed revenue transactions</small>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm border-0 h-100" style="background: linear-gradient(135deg, #f8d7da 0%, #f5c6cb 100%);">
                <div class="card-body p-4">
                    <h6 class="card-title fw-bold text-dark mb-3">
                        <i class="fas fa-arrow-down text-danger me-2"></i>Total Expense
                    </h6>
                    <div class="display-6 fw-bold text-danger mb-2">$@Model.TotalExpense.ToString("N2")</div>
                    <small class="text-muted">From completed expense transactions</small>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm border-0 h-100 @(Model.NetAmount >= 0 ? "border-success" : "border-danger") border-2" 
                 style="background: @(Model.NetAmount >= 0 ? "linear-gradient(135deg, #d1ecf1 0%, #bee5eb 100%)" : "linear-gradient(135deg, #f8d7da 0%, #f5c6cb 100%)");">
                <div class="card-body p-4">
                    <h6 class="card-title fw-bold text-dark mb-3">
                        <i class="fas fa-balance-scale me-2"></i>Net Amount
                    </h6>
                    <div class="display-6 fw-bold @(Model.NetAmount >= 0 ? "text-success" : "text-danger") mb-2">$@Model.NetAmount.ToString("N2")</div>
                    <small class="text-muted">Revenue - Expense</small>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm border-0 h-100" style="background: linear-gradient(135deg, #e2e3e5 0%, #d3d3d3 100%);">
                <div class="card-body p-4">
                    <h6 class="card-title fw-bold text-dark mb-3">
                        <i class="fas fa-list-check me-2"></i>Total Transactions
                    </h6>
                    <div class="display-6 fw-bold text-dark mb-2">@Model.TotalTransactions</div>
                    <small class="text-muted">Filtered transaction count</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-filter me-2"></i>Filter Transactions</h5>
                </div>
                <div class="card-body">
                    <form method="get" class="row g-3">
                        <div class="col-md-2">
                            <label for="transactionTypeFilter" class="form-label fw-semibold">Type</label>
                            <select class="form-select" id="transactionTypeFilter" name="TransactionTypeFilter" onchange="this.form.submit()">
                                <option value="">All Types</option>
                                <option value="Revenue" selected="@(Model.TransactionTypeFilter == "Revenue")">Revenue</option>
                                <option value="Expense" selected="@(Model.TransactionTypeFilter == "Expense")">Expense</option>
                            </select>
                        </div>

                        <div class="col-md-2">
                            <label for="statusFilter" class="form-label fw-semibold">Status</label>
                            <select class="form-select" id="statusFilter" name="StatusFilter" onchange="this.form.submit()">
                                <option value="">All Status</option>
                                <option value="Pending" selected="@(Model.StatusFilter == "Pending")">Pending</option>
                                <option value="Completed" selected="@(Model.StatusFilter == "Completed")">Completed</option>
                                <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Cancelled</option>
                            </select>
                        </div>

                        <div class="col-md-2">
                            <label for="accountIdFilter" class="form-label fw-semibold">Account</label>
                            <select class="form-select" id="accountIdFilter" name="AccountIdFilter" onchange="this.form.submit()">
                                <option value="">All Accounts</option>
                                @foreach (var account in Model.Accounts)
                                {
                                    <option value="@account.Id" selected="@(Model.AccountIdFilter == account.Id)">@account.AccountName</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-2">
                            <label for="dateFromFilter" class="form-label fw-semibold">From Date</label>
                            <input type="date" class="form-control" id="dateFromFilter" name="DateFromFilter" value="@Model.DateFromFilter?.ToString("yyyy-MM-dd")" onchange="this.form.submit()">
                        </div>

                        <div class="col-md-2">
                            <label for="dateToFilter" class="form-label fw-semibold">To Date</label>
                            <input type="date" class="form-control" id="dateToFilter" name="DateToFilter" value="@Model.DateToFilter?.ToString("yyyy-MM-dd")" onchange="this.form.submit()">
                        </div>

                        <div class="col-md-2 d-flex align-items-end">
                            <a href="/Transactions" class="btn btn-outline-secondary w-100">
                                <i class="fas fa-times me-1"></i>Clear
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Add Transaction Form -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-plus me-2"></i>Add New Transaction</h5>
                </div>
                <div class="card-body">
                    <form method="post" asp-page-handler="Async">
                        <div class="row g-3">
                            <!-- Description -->
                            <div class="col-md-4">
                                <label asp-for="TransactionForm.Description" class="form-label fw-semibold">Description *</label>
                                <input asp-for="TransactionForm.Description" class="form-control" placeholder="e.g., Monthly Software License" required>
                                <span asp-validation-for="TransactionForm.Description" class="text-danger small"></span>
                            </div>

                            <!-- Amount -->
                            <div class="col-md-2">
                                <label asp-for="TransactionForm.Amount" class="form-label fw-semibold">Amount *</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="TransactionForm.Amount" class="form-control" type="number" step="0.01" min="0.01" placeholder="0.00" required>
                                </div>
                                <span asp-validation-for="TransactionForm.Amount" class="text-danger small"></span>
                            </div>

                            <!-- Type -->
                            <div class="col-md-2">
                                <label asp-for="TransactionForm.Type" class="form-label fw-semibold">Type *</label>
                                <select asp-for="TransactionForm.Type" class="form-select" required>
                                    <option value="">Select Type</option>
                                    <option value="Revenue">Revenue</option>
                                    <option value="Expense">Expense</option>
                                </select>
                                <span asp-validation-for="TransactionForm.Type" class="text-danger small"></span>
                            </div>

                            <!-- Date -->
                            <div class="col-md-2">
                                <label asp-for="TransactionForm.TransactionDate" class="form-label fw-semibold">Date *</label>
                                <input asp-for="TransactionForm.TransactionDate" class="form-control" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" required>
                                <span asp-validation-for="TransactionForm.TransactionDate" class="text-danger small"></span>
                            </div>

                            <!-- Account -->
                            <div class="col-md-4">
                                <label asp-for="TransactionForm.AccountId" class="form-label fw-semibold">Account *</label>
                                <select asp-for="TransactionForm.AccountId" class="form-select" required>
                                    <option value="">Select Account</option>
                                    @foreach (var account in Model.Accounts)
                                    {
                                        <option value="@account.Id">@account.AccountName (@account.AccountType)</option>
                                    }
                                </select>
                                <span asp-validation-for="TransactionForm.AccountId" class="text-danger small"></span>
                            </div>

                            <!-- Category -->
                            <div class="col-md-3">
                                <label asp-for="TransactionForm.CategoryId" class="form-label fw-semibold">Category</label>
                                <select asp-for="TransactionForm.CategoryId" class="form-select">
                                    <option value="">Select Category (Optional)</option>
                                    @foreach (var category in Model.Categories)
                                    {
                                        <option value="@category.Id">@category.Name</option>
                                    }
                                </select>
                            </div>

                            <!-- Reference Number -->
                            <div class="col-md-3">
                                <label asp-for="TransactionForm.ReferenceNumber" class="form-label fw-semibold">Reference #</label>
                                <input asp-for="TransactionForm.ReferenceNumber" class="form-control" placeholder="e.g., INV-2024-001">
                            </div>

                            <!-- Notes -->
                            <div class="col-12">
                                <label asp-for="TransactionForm.Notes" class="form-label fw-semibold">Notes</label>
                                <textarea asp-for="TransactionForm.Notes" class="form-control" rows="2" placeholder="Additional details..."></textarea>
                            </div>

                            <!-- Submit Button -->
                            <div class="col-12">
                                <button type="submit" class="btn btn-success btn-lg">
                                    <i class="fas fa-save me-2"></i>Add Transaction
                                </button>
                                <button type="reset" class="btn btn-secondary btn-lg ms-2">
                                    <i class="fas fa-redo me-2"></i>Clear Form
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Transactions List -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h5 class="mb-0 fw-bold"><i class="fas fa-list me-2"></i>Transactions (@Model.Transactions.Count)</h5>
                        </div>
                        <div class="col-md-4 text-md-end">
                            <span class="badge bg-info me-2">Revenue: $@Model.TotalRevenue.ToString("N2")</span>
                            <span class="badge bg-warning">Expense: $@Model.TotalExpense.ToString("N2")</span>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    @if (Model.Transactions.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-striped mb-0">
                                <thead class="table-primary">
                                    <tr>
                                        <th>Date</th>
                                        <th>Description</th>
                                        <th>Account</th>
                                        <th>Category</th>
                                        <th>Type</th>
                                        <th class="text-end">Amount</th>
                                        <th>Status</th>
                                        <th>Reference #</th>
                                        <th>Created By</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var transaction in Model.Transactions)
                                    {
                                        <tr>
                                            <td>@transaction.TransactionDate.ToString("MM/dd/yyyy")</td>
                                            <td class="fw-semibold">@transaction.Description</td>
                                            <td>@transaction.Account?.AccountName</td>
                                            <td>@(transaction.Category?.Name ?? "-")</td>
                                            <td>
                                                <span class="badge @(transaction.Type == "Revenue" ? "bg-success" : "bg-danger")">
                                                    @transaction.Type
                                                </span>
                                            </td>
                                            <td class="text-end fw-bold">$@transaction.Amount.ToString("N2")</td>
                                            <td>
                                                <span class="badge @(transaction.Status == "Completed" ? "bg-success" : transaction.Status == "Pending" ? "bg-warning" : "bg-secondary")">
                                                    @transaction.Status
                                                </span>
                                            </td>
                                            <td>@(string.IsNullOrEmpty(transaction.ReferenceNumber) ? "-" : transaction.ReferenceNumber)</td>
                                            <td>@transaction.CreatedBy</td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-warning edit-btn" data-transaction-id="@transaction.Id" data-bs-toggle="modal" data-bs-target="#editModal">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger delete-btn" data-transaction-id="@transaction.Id">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info m-4" role="alert">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>No transactions found.</strong> Try adjusting your filters or add a new transaction above.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Toast Notifications -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1055;">
        <div id="successToast" class="toast" role="alert">
            <div class="toast-header bg-success text-white">
                <i class="fas fa-check-circle me-2"></i>
                <strong>Success</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body" id="successMessage"></div>
        </div>
        <div id="errorToast" class="toast" role="alert">
            <div class="toast-header bg-danger text-white">
                <i class="fas fa-exclamation-circle me-2"></i>
                <strong>Error</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body" id="errorMessage"></div>
        </div>
    </div>

    <!-- Edit Transaction Modal -->
    <div class="modal fade" id="editModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title fw-bold">Edit Transaction</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form method="post" asp-page-handler="UpdateAsync" id="editForm">
                    <input type="hidden" id="editTransactionId" name="id">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Description</label>
                            <input type="text" class="form-control" id="editDescription" name="TransactionForm.Description" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Amount</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" step="0.01" class="form-control" id="editAmount" name="TransactionForm.Amount" required>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Type</label>
                            <select class="form-select" id="editType" name="TransactionForm.Type" required>
                                <option value="Revenue">Revenue</option>
                                <option value="Expense">Expense</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Date</label>
                            <input type="date" class="form-control" id="editDate" name="TransactionForm.TransactionDate" required>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-warning">Update</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Show success/error toasts
    @if (TempData["Success"] != null)
    {
        <text>
        showSuccessToast('@Html.Raw(TempData["Success"])');
        </text>
    }
    @if (TempData["Error"] != null)
    {
        <text>
        showErrorToast('@Html.Raw(TempData["Error"])');
        </text>
    }

    // Delete transaction handler
    document.querySelectorAll('.delete-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const id = this.getAttribute('data-transaction-id');
            if (confirm('Are you sure you want to delete this transaction?')) {
                const formData = new FormData();
                formData.append('id', id);
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                formData.append('__RequestVerificationToken', token);

                fetch(`?handler=DeleteAsync`, {
                    method: 'POST',
                    body: formData
                })
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        showErrorToast(data.message);
                    }
                })
                .catch(err => showErrorToast('Error deleting transaction'));
            }
        });
    });

    // Edit transaction handler (mock implementation)
    document.querySelectorAll('.edit-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const id = this.getAttribute('data-transaction-id');
            document.getElementById('editTransactionId').value = id;
            // In a real implementation, you would load transaction details via AJAX
        });
    });
});

function showSuccessToast(message) {
    document.getElementById('successMessage').textContent = message;
    const toast = new bootstrap.Toast(document.getElementById('successToast'));
    toast.show();
}

function showErrorToast(message) {
    document.getElementById('errorMessage').textContent = message;
    const toast = new bootstrap.Toast(document.getElementById('errorToast'));
    toast.show();
}
</script>

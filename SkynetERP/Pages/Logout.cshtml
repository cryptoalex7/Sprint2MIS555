@page
@model SkynetERP.Pages.LogoutModel
@{
    ViewData["Title"] = "Logout";
}

<div class="container-fluid login-page">
    <div class="row justify-content-center align-items-center min-vh-100">
        <div class="col-md-6 col-lg-4">
            <div class="login-card text-center">
                <h1 class="login-title mb-4">Goodbye!</h1>
                <p class="login-subtitle mb-4">You have been successfully logged out.</p>
                <a href="/Index" class="btn purple-button">
                    <i class="fas fa-sign-in-alt me-2"></i>Sign In Again
                </a>
            </div>
        </div>
    </div>
</div>

@page
@model IndexModel
@{
    ViewData["Title"] = "SkynetERP - Sign In";
}

<div class="container-fluid login-page">
    <div class="row justify-content-center align-items-center min-vh-100">
        <div class="col-md-5 col-lg-4">
            <div class="login-card">
                <!-- Company Logo -->
                <div class="text-center mb-3">
                    <img src="~/images/SkynetLogo.png" alt="Skynet Solutions Logo" class="login-logo" />
                </div>

                <!-- Login Form -->
                <div class="login-form">
                    <h1 class="login-title text-center mb-3">Welcome Back</h1>
                    <p class="login-subtitle text-center text-muted mb-3">Sign in to your SkynetERP account</p>


                    <form method="post" asp-page-handler="OnPostAsync">
                        <div class="mb-3">
                            <label asp-for="Login.Email" class="form-label form-label-hrm">Email</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fas fa-envelope"></i>
                                </span>
                                <input asp-for="Login.Email" type="email" class="form-control form-control-hrm" 
                                       placeholder="Enter your email" required>
                            </div>
                            <span asp-validation-for="Login.Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Login.Password" class="form-label form-label-hrm">Password</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fas fa-lock"></i>
                                </span>
                                <input asp-for="Login.Password" type="password" class="form-control form-control-hrm" 
                                       placeholder="Enter your password" required>
                                <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Login.Password" class="text-danger"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn purple-button">
                                <i class="fas fa-sign-in-alt me-2"></i>Sign In
                            </button>
                        </div>
                    </form>

                    <!-- Toast Container -->
                    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1055;">
                        <div id="successToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="true" data-bs-delay="5000">
                            <div class="toast-header bg-success text-white d-flex align-items-center">
                                <i class="fas fa-check-circle me-2"></i>
                                <strong class="me-auto">Success</strong>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
                            </div>
                            <div class="toast-body bg-white" id="successToastBody"></div>
                        </div>
                        <div id="errorToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="true" data-bs-delay="5000">
                            <div class="toast-header bg-danger text-white d-flex align-items-center">
                                <i class="fas fa-exclamation-circle me-2"></i>
                                <strong class="me-auto">Error</strong>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
                            </div>
                            <div class="toast-body bg-white" id="errorToastBody"></div>
                        </div>
                    </div>

                    <div class="text-center mt-4">
                        <p class="mb-0 text-muted">
                            Don't have an account? 
                            <a href="/Register" class="text-primary fw-semibold">Sign Up</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        // Password toggle functionality
        document.getElementById('togglePassword').addEventListener('click', function() {
            const passwordField = document.getElementById('Login_Password');
            const toggleIcon = this.querySelector('i');
            
            if (passwordField.type === 'password') {
                passwordField.type = 'text';
                toggleIcon.classList.remove('fa-eye');
                toggleIcon.classList.add('fa-eye-slash');
            } else {
                passwordField.type = 'password';
                toggleIcon.classList.remove('fa-eye-slash');
                toggleIcon.classList.add('fa-eye');
            }
        });

        // Add focus effects
        document.querySelectorAll('.form-control').forEach(input => {
            input.addEventListener('focus', function() {
                this.parentElement.classList.add('focused');
            });
            
            input.addEventListener('blur', function() {
                if (!this.value) {
                    this.parentElement.classList.remove('focused');
                }
            });
        });

        // Show toast notifications if messages exist
        @if (TempData["RegistrationSuccess"] != null)
        {
            <text>
            const successToastEl = document.getElementById('successToast');
            const successToast = new bootstrap.Toast(successToastEl, { autohide: true, delay: 5000 });
            document.getElementById('successToastBody').textContent = '@Html.Raw(TempData["RegistrationSuccess"])';
            successToast.show();
            </text>
        }
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <text>
            const errorToastEl = document.getElementById('errorToast');
            const errorToast = new bootstrap.Toast(errorToastEl, { autohide: true, delay: 5000 });
            document.getElementById('errorToastBody').textContent = '@Html.Raw(Model.ErrorMessage)';
            errorToast.show();
            </text>
        }
    </script>
}

@page
@model SkynetERP.Pages.HRMModel
@{
    ViewData["Title"] = "Human Resource Management";
}

<div class="container-fluid hrm-page">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-4 text-center fw-bold text-primary mb-0">Human Resource Management</h1>
            <p class="text-center text-muted">Manage your workforce efficiently and effectively</p>
        </div>
    </div>

    <!-- Section Cards -->
    <div class="row mb-5">
        <div class="col-12">
            <h2 class="h4 fw-bold mb-3 text-dark">Quick Access</h2>
            <div class="row g-4">
                <div class="col-lg-3 col-md-6">
                    <div class="card h-100 shadow-sm border-0 hrm-card" role="button" tabindex="0" aria-label="Employee Onboarding">
                        <div class="card-body text-center p-4">
                            <div class="hrm-icon mb-3">
                                <i class="fas fa-user-plus fa-3x text-primary"></i>
                            </div>
                            <h5 class="card-title fw-bold">Onboarding</h5>
                            <p class="card-text text-muted">Manage new employee onboarding process</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="card h-100 shadow-sm border-0 hrm-card" role="button" tabindex="0" aria-label="Performance Management">
                        <div class="card-body text-center p-4">
                            <div class="hrm-icon mb-3">
                                <i class="fas fa-chart-line fa-3x text-success"></i>
                            </div>
                            <h5 class="card-title fw-bold">Performance</h5>
                            <p class="card-text text-muted">Track and manage employee performance</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="card h-100 shadow-sm border-0 hrm-card" role="button" tabindex="0" aria-label="Benefits Administration">
                        <div class="card-body text-center p-4">
                            <div class="hrm-icon mb-3">
                                <i class="fas fa-heart fa-3x text-warning"></i>
                            </div>
                            <h5 class="card-title fw-bold">Benefits</h5>
                            <p class="card-text text-muted">Manage employee benefits and compensation</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="card h-100 shadow-sm border-0 hrm-card" role="button" tabindex="0" aria-label="Reports and Analytics">
                        <div class="card-body text-center p-4">
                            <div class="hrm-icon mb-3">
                                <i class="fas fa-chart-bar fa-3x text-info"></i>
                            </div>
                            <h5 class="card-title fw-bold">Reports</h5>
                            <p class="card-text text-muted">Generate HR reports and analytics</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Employee Directory Section -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <h2 class="h4 mb-0 fw-bold">Employee Directory</h2>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <button class="btn btn-light btn-sm me-2" data-bs-toggle="modal" data-bs-target="#addEmployeeModal" aria-label="Add New Employee">
                                <i class="fas fa-plus me-1"></i>Add Employee
                            </button>
                            <button class="btn btn-outline-light btn-sm" aria-label="Export Employee Data">
                                <i class="fas fa-download me-1"></i>Export
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <!-- Search and Filter Bar -->
                    <div class="p-3 bg-light border-bottom">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label for="searchInput" class="form-label fw-semibold">Search Employees</label>
                                <input type="text" class="form-control form-control-hrm" id="searchInput" placeholder="Search by name, department, or role..." aria-label="Search employees">
                            </div>
                            <div class="col-md-3">
                                <label for="departmentFilter" class="form-label fw-semibold">Department</label>
                                <select class="form-select form-control-hrm" id="departmentFilter" aria-label="Filter by department">
                                    <option value="">All Departments</option>
                                    <option value="IT">Information Technology</option>
                                    <option value="HR">Human Resources</option>
                                    <option value="Finance">Finance</option>
                                    <option value="Marketing">Marketing</option>
                                    <option value="Operations">Operations</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label for="roleFilter" class="form-label fw-semibold">Role</label>
                                <select class="form-select form-control-hrm" id="roleFilter" aria-label="Filter by role">
                                    <option value="">All Roles</option>
                                    <option value="Manager">Manager</option>
                                    <option value="Developer">Developer</option>
                                    <option value="Analyst">Analyst</option>
                                    <option value="Specialist">Specialist</option>
                                    <option value="Coordinator">Coordinator</option>
                                </select>
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button class="btn btn-outline-secondary w-100" id="clearFilters" aria-label="Clear all filters">
                                    <i class="fas fa-times me-1"></i>Clear
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Employee Table -->
                    <div class="table-responsive">
                        <table class="table table-hover table-hrm mb-0" id="employeeTable" role="table" aria-label="Employee Directory">
                            <thead class="table-primary">
                                <tr>
                                    <th scope="col" class="fw-bold">Name</th>
                                    <th scope="col" class="fw-bold">Department</th>
                                    <th scope="col" class="fw-bold">Role</th>
                                    <th scope="col" class="fw-bold">Address</th>
                                    <th scope="col" class="fw-bold">Phone</th>
                                    <th scope="col" class="fw-bold">Salary</th>
                                    <th scope="col" class="fw-bold text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Sample Data - Replace with actual data binding -->
                                <tr>
                                    <td class="fw-semibold">John Smith</td>
                                    <td><span class="badge badge-hrm bg-primary">IT</span></td>
                                    <td>Senior Developer</td>
                                    <td>123 Main St, City, State</td>
                                    <td>(555) 123-4567</td>
                                    <td class="text-success fw-bold">$85,000</td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-hrm" role="group" aria-label="Employee actions">
                                            <button class="btn btn-sm btn-outline-primary" title="View Details" aria-label="View employee details">
                                                <i class="fas fa-eye"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-warning" title="Edit Employee" aria-label="Edit employee">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" title="Delete Employee" aria-label="Delete employee">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold">Sarah Johnson</td>
                                    <td><span class="badge badge-hrm bg-success">HR</span></td>
                                    <td>HR Manager</td>
                                    <td>456 Oak Ave, City, State</td>
                                    <td>(555) 234-5678</td>
                                    <td class="text-success fw-bold">$75,000</td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-hrm" role="group" aria-label="Employee actions">
                                            <button class="btn btn-sm btn-outline-primary" title="View Details" aria-label="View employee details">
                                                <i class="fas fa-eye"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-warning" title="Edit Employee" aria-label="Edit employee">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" title="Delete Employee" aria-label="Delete employee">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold">Mike Davis</td>
                                    <td><span class="badge badge-hrm bg-warning">Finance</span></td>
                                    <td>Financial Analyst</td>
                                    <td>789 Pine St, City, State</td>
                                    <td>(555) 345-6789</td>
                                    <td class="text-success fw-bold">$65,000</td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-hrm" role="group" aria-label="Employee actions">
                                            <button class="btn btn-sm btn-outline-primary" title="View Details" aria-label="View employee details">
                                                <i class="fas fa-eye"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-warning" title="Edit Employee" aria-label="Edit employee">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" title="Delete Employee" aria-label="Delete employee">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Employee Modal -->
<div class="modal fade modal-hrm" id="addEmployeeModal" tabindex="-1" aria-labelledby="addEmployeeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="addEmployeeModalLabel">Add New Employee</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addEmployeeForm" novalidate>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="firstName" class="form-label fw-semibold">First Name *</label>
                            <input type="text" class="form-control form-control-hrm" id="firstName" required aria-describedby="firstNameHelp">
                            <div class="invalid-feedback">Please provide a valid first name.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="lastName" class="form-label fw-semibold">Last Name *</label>
                            <input type="text" class="form-control form-control-hrm" id="lastName" required>
                            <div class="invalid-feedback">Please provide a valid last name.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="department" class="form-label fw-semibold">Department *</label>
                            <select class="form-select form-control-hrm" id="department" required>
                                <option value="">Select Department</option>
                                <option value="IT">Information Technology</option>
                                <option value="HR">Human Resources</option>
                                <option value="Finance">Finance</option>
                                <option value="Marketing">Marketing</option>
                                <option value="Operations">Operations</option>
                            </select>
                            <div class="invalid-feedback">Please select a department.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="role" class="form-label fw-semibold">Role *</label>
                            <input type="text" class="form-control form-control-hrm" id="role" required>
                            <div class="invalid-feedback">Please provide a valid role.</div>
                        </div>
                        <div class="col-12">
                            <label for="address" class="form-label fw-semibold">Address *</label>
                            <textarea class="form-control form-control-hrm" id="address" rows="2" required></textarea>
                            <div class="invalid-feedback">Please provide a valid address.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="phone" class="form-label fw-semibold">Phone Number *</label>
                            <input type="tel" class="form-control form-control-hrm" id="phone" required pattern="[0-9]{3}-[0-9]{3}-[0-9]{4}" placeholder="555-123-4567">
                            <div class="invalid-feedback">Please provide a valid phone number (555-123-4567).</div>
                        </div>
                        <div class="col-md-6">
                            <label for="salary" class="form-label fw-semibold">Salary *</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control form-control-hrm" id="salary" required min="0" step="1000">
                                <div class="invalid-feedback">Please provide a valid salary.</div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveEmployee">Save Employee</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        // Search functionality
        document.getElementById('searchInput').addEventListener('input', function() {
            filterTable();
        });

        // Filter functionality
        document.getElementById('departmentFilter').addEventListener('change', function() {
            filterTable();
        });

        document.getElementById('roleFilter').addEventListener('change', function() {
            filterTable();
        });

        // Clear filters
        document.getElementById('clearFilters').addEventListener('click', function() {
            document.getElementById('searchInput').value = '';
            document.getElementById('departmentFilter').value = '';
            document.getElementById('roleFilter').value = '';
            filterTable();
        });

        function filterTable() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            const departmentFilter = document.getElementById('departmentFilter').value;
            const roleFilter = document.getElementById('roleFilter').value;
            const table = document.getElementById('employeeTable');
            const rows = table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');

            for (let i = 0; i < rows.length; i++) {
                const row = rows[i];
                const name = row.cells[0].textContent.toLowerCase();
                const department = row.cells[1].textContent;
                const role = row.cells[2].textContent.toLowerCase();

                const matchesSearch = name.includes(searchTerm) || role.includes(searchTerm);
                const matchesDepartment = !departmentFilter || department.includes(departmentFilter);
                const matchesRole = !roleFilter || role.includes(roleFilter.toLowerCase());

                if (matchesSearch && matchesDepartment && matchesRole) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            }
        }

        // Form validation
        document.getElementById('addEmployeeForm').addEventListener('submit', function(event) {
            event.preventDefault();
            event.stopPropagation();
            
            const form = event.currentTarget;
            if (form.checkValidity()) {
                // Handle form submission here
                alert('Employee added successfully!');
                form.reset();
                form.classList.remove('was-validated');
                bootstrap.Modal.getInstance(document.getElementById('addEmployeeModal')).hide();
            } else {
                form.classList.add('was-validated');
            }
        });

        // Save employee button
        document.getElementById('saveEmployee').addEventListener('click', function() {
            document.getElementById('addEmployeeForm').dispatchEvent(new Event('submit'));
        });

        // Card click handlers
        document.querySelectorAll('.hrm-card').forEach(card => {
            card.addEventListener('click', function() {
                const title = this.querySelector('.card-title').textContent;
                alert(`Navigating to ${title} section...`);
            });
        });
    </script>
}

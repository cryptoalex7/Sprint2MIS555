@page
@model SkynetERP.Pages.HRMModel
@{
    ViewData["Title"] = "Human Resource Management";
}

@Html.AntiForgeryToken()

<div class="hrm-page">
    <!-- Toast Container -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1055;">
        <div id="successToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="true" data-bs-delay="5000">
            <div class="toast-header bg-success text-white d-flex align-items-center">
                <i class="fas fa-check-circle me-2"></i>
                <strong class="me-auto">Success</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body bg-white" id="successToastBody"></div>
        </div>
        <div id="errorToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="true" data-bs-delay="5000">
            <div class="toast-header bg-danger text-white d-flex align-items-center">
                <i class="fas fa-exclamation-circle me-2"></i>
                <strong class="me-auto">Error</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body bg-white" id="errorToastBody"></div>
        </div>
    </div>

    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-4 fw-bold text-primary mb-0">Human Resource Management</h1>
            <p class="text-muted">Manage your workforce efficiently and effectively</p>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-5">
        <div class="col-12">
            <h2 class="h4 fw-bold mb-3 text-dark">HR Statistics</h2>
            <div class="row g-4">
                <div class="col-lg-3 col-md-6">
                    <div class="card h-100 shadow-sm border-0 hrm-card">
                        <div class="card-body text-center p-4">
                            <div class="hrm-icon mb-3">
                                <i class="fas fa-users fa-3x text-primary"></i>
                            </div>
                            <h5 class="card-title fw-bold">Employees</h5>
                            <p class="card-text">
                                <span class="display-6 fw-bold text-primary">@Model.TotalEmployees</span>
                                <br>
                                <small class="text-muted">Total Employees</small>
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="card h-100 shadow-sm border-0 hrm-card">
                        <div class="card-body text-center p-4">
                            <div class="hrm-icon mb-3">
                                <i class="fas fa-building fa-3x text-success"></i>
                            </div>
                            <h5 class="card-title fw-bold">Departments</h5>
                            <p class="card-text">
                                <span class="display-6 fw-bold text-success">@Model.TotalDepartments</span>
                                <br>
                                <small class="text-muted">Total Departments</small>
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="card h-100 shadow-sm border-0 hrm-card">
                        <div class="card-body text-center p-4">
                            <div class="hrm-icon mb-3">
                                <i class="fas fa-dollar-sign fa-3x text-warning"></i>
                            </div>
                            <h5 class="card-title fw-bold">Average Salary</h5>
                            <p class="card-text">
                                @if (Model.CanViewSalary && Model.AverageSalary > 0)
                                {
                                    <span class="display-6 fw-bold text-warning">$@Model.AverageSalary.ToString("N0")</span>
                                    <br>
                                    <small class="text-muted">Per Employee</small>
                                }
                                else
                                {
                                    <span class="display-6 fw-bold text-muted">N/A</span>
                                    <br>
                                    <small class="text-muted">Access Restricted</small>
                                }
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="card h-100 shadow-sm border-0 hrm-card">
                        <div class="card-body text-center p-4">
                            <div class="hrm-icon mb-3">
                                <i class="fas fa-money-bill-wave fa-3x text-info"></i>
                            </div>
                            <h5 class="card-title fw-bold">Payroll</h5>
                            <p class="card-text">
                                @if (Model.CanViewSalary && Model.MonthlyPayroll > 0)
                                {
                                    <span class="display-6 fw-bold text-info">$@Model.MonthlyPayroll.ToString("N0")</span>
                                    <br>
                                    <small class="text-muted">Monthly Total</small>
                                }
                                else
                                {
                                    <span class="display-6 fw-bold text-muted">N/A</span>
                                    <br>
                                    <small class="text-muted">Access Restricted</small>
                                }
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Employee Directory Section -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <h2 class="h4 mb-0 fw-bold">Employee Directory</h2>
                        </div>
                        <div class="col-md-6 text-md-end">
                            @if (Model.CanEditDelete)
                            {
                                <button class="btn btn-light btn-sm me-2" data-bs-toggle="modal" data-bs-target="#addEmployeeModal" aria-label="Add New Employee">
                                    <i class="fas fa-plus me-1"></i>Add Employee
                                </button>
                            }
                            <button class="btn btn-outline-light btn-sm" id="exportBtn" aria-label="Export Employee Data">
                                <i class="fas fa-download me-1"></i>Export
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <!-- Search and Filter Bar -->
                    <div class="p-3 bg-light border-bottom">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label for="searchInput" class="form-label fw-semibold">Search Employees</label>
                                <input type="text" class="form-control form-control-hrm" id="searchInput" placeholder="Search by name, department, or role..." aria-label="Search employees">
                            </div>
                            <div class="col-md-3">
                                <label for="departmentFilter" class="form-label fw-semibold">Department</label>
                                <select class="form-select form-control-hrm" id="departmentFilter" aria-label="Filter by department">
                                    <option value="">All Departments</option>
                                    <option value="IT">Information Technology</option>
                                    <option value="HR">Human Resources</option>
                                    <option value="Finance">Finance</option>
                                    <option value="Marketing">Marketing</option>
                                    <option value="Operations">Operations</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label for="roleFilter" class="form-label fw-semibold">Role</label>
                                <select class="form-select form-control-hrm" id="roleFilter" aria-label="Filter by role">
                                    <option value="">All Roles</option>
                                    <option value="Manager">Manager</option>
                                    <option value="Developer">Developer</option>
                                    <option value="Analyst">Analyst</option>
                                    <option value="Specialist">Specialist</option>
                                    <option value="Coordinator">Coordinator</option>
                                </select>
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button class="btn btn-outline-secondary w-100" id="clearFilters" aria-label="Clear all filters">
                                    <i class="fas fa-times me-1"></i>Clear
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Employee Table -->
                    <div class="table-responsive">
                        <table class="table table-hover table-hrm mb-0" id="employeeTable" role="table" aria-label="Employee Directory">
                            <thead class="table-primary">
                                <tr>
                                    <th scope="col" class="fw-bold">Name</th>
                                    <th scope="col" class="fw-bold">Department</th>
                                    <th scope="col" class="fw-bold">Role</th>
                                    <th scope="col" class="fw-bold">Address</th>
                                    <th scope="col" class="fw-bold">Phone</th>
                                    @if (Model.CanViewSalary)
                                    {
                                        <th scope="col" class="fw-bold">Salary</th>
                                    }
                                    @if (Model.CanEditDelete)
                                    {
                                        <th scope="col" class="fw-bold text-center">Actions</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Employees != null && Model.Employees.Any())
                                {
                                    @foreach (var employee in Model.Employees)
                                    {
                                        var badgeClass = employee.Department switch
                                        {
                                            "IT" => "bg-primary",
                                            "HR" => "bg-success",
                                            "Finance" => "bg-warning",
                                            "Marketing" => "bg-info",
                                            "Operations" => "bg-secondary",
                                            _ => "bg-dark"
                                        };
                                        <tr data-employee-id="@employee.Id">
                                            <td class="fw-semibold">@employee.FullName</td>
                                            <td><span class="badge badge-hrm @badgeClass">@employee.Department</span></td>
                                            <td>@employee.Role</td>
                                            <td>@employee.Address</td>
                                            <td>@employee.Phone</td>
                                            @if (Model.CanViewSalary)
                                            {
                                                <td class="text-success fw-bold">$@employee.Salary.ToString("N0")</td>
                                            }
                                            @if (Model.CanEditDelete)
                                            {
                                                <td class="text-center">
                                                    <div class="btn-group btn-group-hrm" role="group" aria-label="Employee actions">
                                                        <button class="btn btn-sm btn-outline-warning edit-employee-btn" 
                                                                data-employee-id="@employee.Id"
                                                                data-employee-firstname="@employee.FirstName"
                                                                data-employee-lastname="@employee.LastName"
                                                                data-employee-department="@employee.Department"
                                                                data-employee-role="@employee.Role"
                                                                data-employee-address="@employee.Address"
                                                                data-employee-phone="@employee.Phone"
                                                                data-employee-salary="@employee.Salary"
                                                                title="Edit Employee" 
                                                                aria-label="Edit employee">
                                                            <i class="fas fa-edit"></i>
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-danger delete-employee-btn" 
                                                                data-employee-id="@employee.Id" 
                                                                data-employee-name="@employee.FullName"
                                                                title="Delete Employee" 
                                                                aria-label="Delete employee">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            }
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        @{
                                            var colCount = 5; // Name, Department, Role, Address, Phone
                                            if (Model.CanViewSalary) colCount++;
                                            if (Model.CanEditDelete) colCount++;
                                        }
                                        <td colspan="@colCount" class="text-center text-muted py-4">
                                            No employees found.@(Model.CanEditDelete ? " Click \"Add Employee\" to get started." : "")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Employee Modal -->
<div class="modal fade modal-hrm" id="addEmployeeModal" tabindex="-1" aria-labelledby="addEmployeeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="addEmployeeModalLabel">Add New Employee</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addEmployeeForm" novalidate>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="firstName" class="form-label fw-semibold">First Name *</label>
                            <input type="text" class="form-control form-control-hrm" id="firstName" required aria-describedby="firstNameHelp">
                            <div class="invalid-feedback">Please provide a valid first name.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="lastName" class="form-label fw-semibold">Last Name *</label>
                            <input type="text" class="form-control form-control-hrm" id="lastName" required>
                            <div class="invalid-feedback">Please provide a valid last name.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="department" class="form-label fw-semibold">Department *</label>
                            <select class="form-select form-control-hrm" id="department" required>
                                <option value="">Select Department</option>
                                <option value="IT">Information Technology</option>
                                <option value="HR">Human Resources</option>
                                <option value="Finance">Finance</option>
                                <option value="Marketing">Marketing</option>
                                <option value="Operations">Operations</option>
                            </select>
                            <div class="invalid-feedback">Please select a department.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="role" class="form-label fw-semibold">Role *</label>
                            <input type="text" class="form-control form-control-hrm" id="role" required>
                            <div class="invalid-feedback">Please provide a valid role.</div>
                        </div>
                        <div class="col-12">
                            <label for="address" class="form-label fw-semibold">Address *</label>
                            <textarea class="form-control form-control-hrm" id="address" rows="2" required></textarea>
                            <div class="invalid-feedback">Please provide a valid address.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="phone" class="form-label fw-semibold">Phone Number *</label>
                            <input type="tel" class="form-control form-control-hrm" id="phone" required pattern="\(\d{3}\)-\d{3}-\d{4}" placeholder="(555)-123-4567" maxlength="14">
                            <div class="invalid-feedback">Please provide a valid 10-digit phone number (555)-123-4567.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="salary" class="form-label fw-semibold">Salary *</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control form-control-hrm" id="salary" required min="0" max="10000000" step="1">
                                <div class="invalid-feedback">Please provide a valid salary between 0 and 10,000,000.</div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveEmployee">Save Employee</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Employee Modal -->
<div class="modal fade modal-hrm" id="editEmployeeModal" tabindex="-1" aria-labelledby="editEmployeeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title fw-bold" id="editEmployeeModalLabel">Edit Employee</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editEmployeeForm" novalidate>
                    <input type="hidden" id="editEmployeeId" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="editFirstName" class="form-label fw-semibold">First Name *</label>
                            <input type="text" class="form-control form-control-hrm" id="editFirstName" required>
                            <div class="invalid-feedback">Please provide a valid first name.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="editLastName" class="form-label fw-semibold">Last Name *</label>
                            <input type="text" class="form-control form-control-hrm" id="editLastName" required>
                            <div class="invalid-feedback">Please provide a valid last name.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="editDepartment" class="form-label fw-semibold">Department *</label>
                            <select class="form-select form-control-hrm" id="editDepartment" required>
                                <option value="">Select Department</option>
                                <option value="IT">Information Technology</option>
                                <option value="HR">Human Resources</option>
                                <option value="Finance">Finance</option>
                                <option value="Marketing">Marketing</option>
                                <option value="Operations">Operations</option>
                            </select>
                            <div class="invalid-feedback">Please select a department.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="editRole" class="form-label fw-semibold">Role *</label>
                            <input type="text" class="form-control form-control-hrm" id="editRole" required>
                            <div class="invalid-feedback">Please provide a valid role.</div>
                        </div>
                        <div class="col-12">
                            <label for="editAddress" class="form-label fw-semibold">Address *</label>
                            <textarea class="form-control form-control-hrm" id="editAddress" rows="2" required></textarea>
                            <div class="invalid-feedback">Please provide a valid address.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="editPhone" class="form-label fw-semibold">Phone Number *</label>
                            <input type="tel" class="form-control form-control-hrm" id="editPhone" required pattern="\(\d{3}\)-\d{3}-\d{4}" placeholder="(555)-123-4567" maxlength="14">
                            <div class="invalid-feedback">Please provide a valid 10-digit phone number (555)-123-4567.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="editSalary" class="form-label fw-semibold">Salary *</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control form-control-hrm" id="editSalary" required min="0" max="10000000" step="1">
                                <div class="invalid-feedback">Please provide a valid salary between 0 and 10,000,000.</div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" id="updateEmployee">Update Employee</button>
            </div>
        </div>
    </div>
</div>

<!-- Export Confirmation Modal -->
<div class="modal fade" id="exportConfirmModal" tabindex="-1" aria-labelledby="exportConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title fw-bold" id="exportConfirmModalLabel">
                    <i class="fas fa-file-csv me-2"></i>Export Employee Data
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3">Are you sure you want to export the employee directory as a CSV file?</p>
                <div class="alert alert-info mb-0">
                    <i class="fas fa-info-circle me-2"></i>
                    <strong>File Format:</strong> CSV (Comma-Separated Values)
                    <br>
                    <small id="exportDescription">The export will include all employee information: Name, Department, Role, Address, Phone@(Model.CanViewSalary ? ", and Salary" : "").</small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-info" id="confirmExportBtn">
                    <i class="fas fa-download me-1"></i>Download CSV
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold" id="deleteConfirmModalLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>Confirm Deletion
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3">Are you sure you want to delete this employee?</p>
                <div class="alert alert-warning mb-0">
                    <strong id="employeeNameToDelete"></strong>
                </div>
                <p class="text-muted mt-3 mb-0">
                    <small>This action cannot be undone. All employee information will be permanently deleted.</small>
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                    <i class="fas fa-trash me-1"></i>Yes, Delete Employee
                </button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        // Search functionality
        document.getElementById('searchInput').addEventListener('input', function() {
            filterTable();
        });

        // Filter functionality
        document.getElementById('departmentFilter').addEventListener('change', function() {
            filterTable();
        });

        document.getElementById('roleFilter').addEventListener('change', function() {
            filterTable();
        });

        // Clear filters
        document.getElementById('clearFilters').addEventListener('click', function() {
            document.getElementById('searchInput').value = '';
            document.getElementById('departmentFilter').value = '';
            document.getElementById('roleFilter').value = '';
            filterTable();
        });

        function filterTable() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            const departmentFilter = document.getElementById('departmentFilter').value;
            const roleFilter = document.getElementById('roleFilter').value;
            const table = document.getElementById('employeeTable');
            const rows = table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');

            for (let i = 0; i < rows.length; i++) {
                const row = rows[i];
                const name = row.cells[0].textContent.toLowerCase();
                const department = row.cells[1].textContent;
                const role = row.cells[2].textContent.toLowerCase();

                const matchesSearch = name.includes(searchTerm) || role.includes(searchTerm);
                const matchesDepartment = !departmentFilter || department.includes(departmentFilter);
                const matchesRole = !roleFilter || role.includes(roleFilter.toLowerCase());

                if (matchesSearch && matchesDepartment && matchesRole) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            }
        }

        // Form validation
        document.getElementById('addEmployeeForm').addEventListener('submit', async function(event) {
            event.preventDefault();
            event.stopPropagation();
            
            const form = event.currentTarget;
            if (form.checkValidity()) {
                await submitNewEmployee();
            } else {
                form.classList.add('was-validated');
            }
        });

        async function submitNewEmployee() {
            const btn = document.getElementById('saveEmployee');
            const originalText = btn.innerHTML;
            
            // Disable button and show loading state
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Saving...';

            try {
                const formData = new FormData();
                formData.append('FirstName', document.getElementById('firstName').value);
                formData.append('LastName', document.getElementById('lastName').value);
                formData.append('Department', document.getElementById('department').value);
                formData.append('Role', document.getElementById('role').value);
                formData.append('Address', document.getElementById('address').value);
                formData.append('Phone', document.getElementById('phone').value);
                formData.append('Salary', document.getElementById('salary').value);
                
                // Get antiforgery token
                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                if (tokenInput) {
                    formData.append('__RequestVerificationToken', tokenInput.value);
                }

                const currentUrl = window.location.pathname;
                const handlerUrl = currentUrl + '?handler=AddEmployee';

                const response = await fetch(handlerUrl, {
                    method: 'POST',
                    body: formData,
                    redirect: 'follow'
                });

                // Check if response is successful (200 OK or redirect)
                if (response.ok || response.status === 302 || response.redirected) {
                    // Success - hide modal and reload page to show new employee
                    const modal = bootstrap.Modal.getInstance(document.getElementById('addEmployeeModal'));
                    if (modal) {
                        modal.hide();
                    }
                    showNotification('Employee added successfully!', 'success');
                    // Reload page to show new employee
                    setTimeout(() => {
                        window.location.reload();
                    }, 500);
                } else {
                    // Handle error response
                    let errorMessage = 'Failed to add employee. Please try again.';
                    try {
                        const contentType = response.headers.get("content-type");
                        if (contentType && contentType.includes("application/json")) {
                            const result = await response.json();
                            errorMessage = result.message || errorMessage;
                        } else {
                            const errorText = await response.text();
                            console.error('Error response:', errorText);
                        }
                    } catch (e) {
                        console.error('Error parsing response:', e);
                    }
                    showNotification(errorMessage, 'error');
                    btn.disabled = false;
                    btn.innerHTML = originalText;
                }
            } catch (error) {
                console.error('Error adding employee:', error);
                showNotification('An error occurred while adding the employee: ' + error.message, 'error');
                btn.disabled = false;
                btn.innerHTML = originalText;
            }
        }

        // Phone number formatting function
        function formatPhoneNumber(input) {
            // Remove all non-digit characters
            let value = input.value.replace(/\D/g, '');
            
            // Limit to 10 digits
            if (value.length > 10) {
                value = value.substring(0, 10);
            }
            
            // Format as (xxx)-xxx-xxxx
            if (value.length >= 6) {
                value = `(${value.substring(0, 3)})-${value.substring(3, 6)}-${value.substring(6)}`;
            } else if (value.length >= 3) {
                value = `(${value.substring(0, 3)})${value.substring(3)}`;
            } else if (value.length > 0) {
                value = `(${value}`;
            }
            
            input.value = value;
        }

        // Auto-format phone number on input
        document.getElementById('phone').addEventListener('input', function() {
            formatPhoneNumber(this);
        });

        document.getElementById('editPhone').addEventListener('input', function() {
            formatPhoneNumber(this);
        });

        // Save employee button
        document.getElementById('saveEmployee').addEventListener('click', function() {
            const form = document.getElementById('addEmployeeForm');
            if (form.checkValidity()) {
                form.dispatchEvent(new Event('submit'));
            } else {
                form.classList.add('was-validated');
            }
        });

        // Reset add employee modal when closed
        document.getElementById('addEmployeeModal').addEventListener('hidden.bs.modal', function() {
            const form = document.getElementById('addEmployeeForm');
            form.reset();
            form.classList.remove('was-validated');
            const btn = document.getElementById('saveEmployee');
            btn.disabled = false;
            btn.innerHTML = 'Save Employee';
        });

        // Export functionality
        const exportModal = new bootstrap.Modal(document.getElementById('exportConfirmModal'));
        
        document.getElementById('exportBtn').addEventListener('click', function() {
            exportModal.show();
        });

        document.getElementById('confirmExportBtn').addEventListener('click', function() {
            const btn = this;
            const originalText = btn.innerHTML;
            
            // Disable button and show loading state
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Downloading...';

            try {
                // Get current URL and add handler
                const currentUrl = window.location.pathname;
                const exportUrl = currentUrl + '?handler=ExportEmployees';
                
                // Create a temporary link to trigger download
                const link = document.createElement('a');
                link.href = exportUrl;
                link.download = '';
                link.style.display = 'none';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                
                // Hide modal and show success message
                setTimeout(() => {
                    exportModal.hide();
                    showNotification('Employee data exported successfully!', 'success');
                    btn.disabled = false;
                    btn.innerHTML = originalText;
                }, 500);
            } catch (error) {
                console.error('Error exporting employees:', error);
                showNotification('An error occurred while exporting the data: ' + error.message, 'error');
                btn.disabled = false;
                btn.innerHTML = originalText;
            }
        });

        // Card click handlers
        document.querySelectorAll('.hrm-card').forEach(card => {
            card.addEventListener('click', function() {
                const title = this.querySelector('.card-title').textContent;
                alert(`Navigating to ${title} section...`);
            });
        });

        // Edit employee functionality
        const editModal = new bootstrap.Modal(document.getElementById('editEmployeeModal'));
        
        function attachEditHandlers() {
            document.querySelectorAll('.edit-employee-btn').forEach(btn => {
                // Remove existing listeners to avoid duplicates
                const newBtn = btn.cloneNode(true);
                btn.parentNode.replaceChild(newBtn, btn);
                
                newBtn.addEventListener('click', function() {
                    const employeeId = parseInt(this.getAttribute('data-employee-id'));
                    const firstName = this.getAttribute('data-employee-firstname');
                    const lastName = this.getAttribute('data-employee-lastname');
                    const department = this.getAttribute('data-employee-department');
                    const role = this.getAttribute('data-employee-role');
                    const address = this.getAttribute('data-employee-address');
                    let phone = this.getAttribute('data-employee-phone');
                    const salary = this.getAttribute('data-employee-salary');
                    
                    // Convert phone format to (xxx)-xxx-xxxx
                    if (phone) {
                        // Remove all non-digit characters
                        const digits = phone.replace(/\D/g, '');
                        if (digits.length === 10) {
                            // Format as (xxx)-xxx-xxxx
                            phone = `(${digits.substring(0, 3)})-${digits.substring(3, 6)}-${digits.substring(6)}`;
                        }
                    }
                    
                    // Populate edit form
                    document.getElementById('editEmployeeId').value = employeeId;
                    document.getElementById('editFirstName').value = firstName;
                    document.getElementById('editLastName').value = lastName;
                    document.getElementById('editDepartment').value = department;
                    document.getElementById('editRole').value = role;
                    document.getElementById('editAddress').value = address;
                    document.getElementById('editPhone').value = phone;
                    document.getElementById('editSalary').value = salary;
                    
                    // Reset validation
                    const form = document.getElementById('editEmployeeForm');
                    form.classList.remove('was-validated');
                    
                    // Show modal
                    editModal.show();
                });
            });
        }

        // Attach edit handlers on page load
        attachEditHandlers();

        // Handle edit form submission
        document.getElementById('editEmployeeForm').addEventListener('submit', function(event) {
            event.preventDefault();
            event.stopPropagation();
            
            const form = event.currentTarget;
            if (form.checkValidity()) {
                submitEmployeeUpdate();
            } else {
                form.classList.add('was-validated');
            }
        });

        // Update employee button
        document.getElementById('updateEmployee').addEventListener('click', function() {
            document.getElementById('editEmployeeForm').dispatchEvent(new Event('submit'));
        });

        async function submitEmployeeUpdate() {
            const btn = document.getElementById('updateEmployee');
            const originalText = btn.innerHTML;
            
            // Disable button and show loading state
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Updating...';

            try {
                const formData = new FormData();
                formData.append('Id', document.getElementById('editEmployeeId').value);
                formData.append('FirstName', document.getElementById('editFirstName').value);
                formData.append('LastName', document.getElementById('editLastName').value);
                formData.append('Department', document.getElementById('editDepartment').value);
                formData.append('Role', document.getElementById('editRole').value);
                formData.append('Address', document.getElementById('editAddress').value);
                formData.append('Phone', document.getElementById('editPhone').value);
                formData.append('Salary', document.getElementById('editSalary').value);
                
                // Get antiforgery token
                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                if (tokenInput) {
                    formData.append('__RequestVerificationToken', tokenInput.value);
                }

                const currentUrl = window.location.pathname;
                const handlerUrl = currentUrl + '?handler=UpdateEmployee';

                const response = await fetch(handlerUrl, {
                    method: 'POST',
                    body: formData
                });

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const contentType = response.headers.get("content-type");
                if (!contentType || !contentType.includes("application/json")) {
                    const text = await response.text();
                    throw new Error('Server returned non-JSON response');
                }

                const result = await response.json();

                if (result.success) {
                    // Hide modal
                    editModal.hide();
                    
                    // Show success message
                    showNotification('Employee updated successfully', 'success');
                    
                    // Reload page to refresh table
                    setTimeout(() => {
                        window.location.reload();
                    }, 1000);
                } else {
                    showNotification(result.message || 'Failed to update employee', 'error');
                    btn.disabled = false;
                    btn.innerHTML = originalText;
                }
            } catch (error) {
                console.error('Error updating employee:', error);
                showNotification('An error occurred while updating the employee: ' + error.message, 'error');
                btn.disabled = false;
                btn.innerHTML = originalText;
            }
        }

        // Reset edit modal when closed
        document.getElementById('editEmployeeModal').addEventListener('hidden.bs.modal', function() {
            document.getElementById('editEmployeeForm').reset();
            document.getElementById('editEmployeeForm').classList.remove('was-validated');
            document.getElementById('updateEmployee').disabled = false;
            document.getElementById('updateEmployee').innerHTML = 'Update Employee';
        });

        // Delete employee functionality
        let employeeIdToDelete = null;
        const deleteModal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));

        // Function to attach delete handlers (for dynamic content)
        function attachDeleteHandlers() {
            document.querySelectorAll('.delete-employee-btn').forEach(btn => {
                // Remove existing listeners to avoid duplicates
                const newBtn = btn.cloneNode(true);
                btn.parentNode.replaceChild(newBtn, btn);
                
                newBtn.addEventListener('click', function() {
                    employeeIdToDelete = parseInt(this.getAttribute('data-employee-id'));
                    const employeeName = this.getAttribute('data-employee-name');
                    
                    // Update modal with employee name
                    document.getElementById('employeeNameToDelete').textContent = employeeName;
                    
                    // Show confirmation modal
                    deleteModal.show();
                });
            });
        }

        // Attach handlers on page load
        attachDeleteHandlers();

        // Handle confirm delete button
        document.getElementById('confirmDeleteBtn').addEventListener('click', async function() {
            if (!employeeIdToDelete) return;

            const btn = this;
            const originalText = btn.innerHTML;
            
            // Disable button and show loading state
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Deleting...';

            try {
                // Make POST request to delete employee
                const formData = new FormData();
                formData.append('id', employeeIdToDelete.toString());
                
                // Get antiforgery token
                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                if (tokenInput) {
                    formData.append('__RequestVerificationToken', tokenInput.value);
                }

                // Get the current page URL
                const currentUrl = window.location.pathname;
                const handlerUrl = currentUrl + '?handler=DeleteEmployee';

                console.log('Deleting employee with ID:', employeeIdToDelete);
                console.log('Request URL:', handlerUrl);

                const response = await fetch(handlerUrl, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'RequestVerificationToken': tokenInput ? tokenInput.value : ''
                    }
                });

                console.log('Response status:', response.status);
                console.log('Response headers:', [...response.headers.entries()]);

                // Check if response is OK
                if (!response.ok) {
                    const errorText = await response.text();
                    console.error('Error response:', errorText);
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                // Check content type
                const contentType = response.headers.get("content-type");
                console.log('Content type:', contentType);
                
                if (!contentType || !contentType.includes("application/json")) {
                    const text = await response.text();
                    console.error('Non-JSON response:', text);
                    throw new Error('Server returned non-JSON response: ' + text.substring(0, 100));
                }

                const result = await response.json();
                console.log('Delete result:', result);

                if (result.success) {
                    // Hide modal
                    deleteModal.hide();
                    
                    // Remove the row from the table
                    const row = document.querySelector(`tr[data-employee-id="${employeeIdToDelete}"]`);
                    if (row) {
                        row.style.transition = 'opacity 0.3s';
                        row.style.opacity = '0';
                        setTimeout(() => {
                            row.remove();
                            
                            // Check if table is empty and show message
                            const tbody = document.querySelector('#employeeTable tbody');
                            if (tbody && tbody.children.length === 0) {
                                @{
                                    var jsColCount = 5; // Name, Department, Role, Address, Phone
                                    if (Model.CanViewSalary) jsColCount++;
                                    if (Model.CanEditDelete) jsColCount++;
                                }
                                const colspan = @jsColCount;
                                @{
                                    var emptyMessage = Model.CanEditDelete 
                                        ? "No employees found. Click \"Add Employee\" to get started." 
                                        : "No employees found.";
                                }
                                tbody.innerHTML = `<tr><td colspan="${colspan}" class="text-center text-muted py-4">@emptyMessage</td></tr>`;
                            }
                        }, 300);
                    }
                    
                    // Show success message
                    showNotification('Employee deleted successfully', 'success');
                } else {
                    showNotification(result.message || 'Failed to delete employee', 'error');
                    btn.disabled = false;
                    btn.innerHTML = originalText;
                }
            } catch (error) {
                console.error('Error deleting employee:', error);
                showNotification('An error occurred while deleting the employee: ' + error.message, 'error');
                btn.disabled = false;
                btn.innerHTML = originalText;
            } finally {
                employeeIdToDelete = null;
            }
        });

        // Reset modal when closed
        document.getElementById('deleteConfirmModal').addEventListener('hidden.bs.modal', function() {
            employeeIdToDelete = null;
            document.getElementById('confirmDeleteBtn').disabled = false;
            document.getElementById('confirmDeleteBtn').innerHTML = '<i class="fas fa-trash me-1"></i>Yes, Delete Employee';
        });

        // Toast notification function (consistent with other pages)
        function showNotification(message, type) {
            const toastId = type === 'success' ? 'successToast' : 'errorToast';
            const bodyId = type === 'success' ? 'successToastBody' : 'errorToastBody';
            const toastElement = document.getElementById(toastId);
            const toastBody = document.getElementById(bodyId);
            
            if (toastElement && toastBody) {
                toastBody.textContent = message;
                const toast = new bootstrap.Toast(toastElement, { autohide: true, delay: 5000 });
                toast.show();
            }
        }
    </script>
}
